+struct MovingBlock : Object                 // TR1 rolling block (Tomb of Qualopec)
+{
+    enum {
+        STATE_START,
+        STATE_END
+    };
+
+    // the block raises the floor of its sector by 2 blocks while it rests (TR1 AlterFloorHeight);
+    // ITEM_FLAG_RAISED says it is raised now (saved with the flags, so a load knows)
+    MovingBlock(Room* room) : Object(room)
+    {
+        flags &= ~ITEM_FLAG_RAISED;
+        if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE) {
+            raise(true);
+        }
+    }
+
+    void raise(bool on)
+    {
+        if (on == ((flags & ITEM_FLAG_RAISED) != 0))
+            return;
+        trapAlterFloor(room, pos.x, pos.y, pos.z, on ? -2 * 1024 : 2 * 1024);
+        flags ^= ITEM_FLAG_RAISED;
+    }
+
+    virtual void update()
+    {
+        if (isActive())
+        {
+            if (state == STATE_START)
+            {
+                goalState = STATE_END;
+                raise(false);
+            }
+        }
+        else if (state == STATE_END)
+        {
+            goalState = STATE_START;
+            raise(false);
+        }
+
+        animProcess();
+        updateRoom();
+
+        if ((flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INACTIVE)
+        {
+            flags &= ~ITEM_FLAG_STATUS;
+            flags |= ITEM_FLAG_STATUS_ACTIVE;
+            pos.x = (pos.x & ~1023) + 512;
+            pos.z = (pos.z & ~1023) + 512;
+            raise(true);
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        collideDefault(lara, cinfo);
+    }
+
+    virtual uint8* load(uint8* data)
+    {
+        raise(false);                           // the floor as it was at level start, here
+        data = ItemObj::load(data);
+        if (flags & ITEM_FLAG_RAISED) {         // raised where the save says
+            flags &= ~ITEM_FLAG_RAISED;
+            raise(true);
+        }
+        return data;
+    }
+};
