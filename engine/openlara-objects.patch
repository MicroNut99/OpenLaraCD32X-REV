+// ------------------------------------------------------------------------- eggs, statues
+struct MutantEgg : Object                   // Atlantis, The Great Pyramid
+{
+    enum {
+        STATE_IDLE,
+        STATE_EXPLODE
+    };
+
+    MutantEgg(Room* room) : Object(room)
+    {
+        ItemType enemy;
+        switch ((flags & ITEM_FLAG_MASK) >> ITEM_FLAGS_MASK_SHIFT)
+        {
+            case 1  : enemy = ITEM_MUTANT_2; break;
+            case 2  : enemy = ITEM_CENTAUR;  break;
+            case 4  : enemy = ITEM_ADAM;     break;
+            case 8  : enemy = ITEM_MUTANT_3; break;
+            default : enemy = ITEM_MUTANT_1;
+        }
+        flags &= ~(ITEM_FLAG_MASK | ITEM_FLAG_REVERSE);
+        visibleMask = 0xFFFE00;
+        // the enemy inside: hidden until the egg opens (ONCE -> invisible, see ItemObj)
+        extra = (uint8*)trapSpawn(enemy, room, pos, angle.y, ITEM_FLAG_ONCE, intensity);
+    }
+
+    void hatch()
+    {
+        goalState = STATE_EXPLODE;
+        visibleMask = 0x1FF;
+        flags &= ~ITEM_FLAG_COLLISION;
+        trapExplosion(room, pos + _vec3i(0, -512, 0));
+        soundPlay(SND_EXPLOSION, &pos);
+
+        ItemObj* enemy = (ItemObj*)extra;
+        if (enemy && (enemy->flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INVISIBLE)
+        {
+            enemy->flags &= ~ITEM_FLAG_STATUS;
+            enemy->flags |= ITEM_FLAG_STATUS_ACTIVE;
+            // the model's first animation can have state 0, which no enemy AI handles (seen in
+            // emulation: the mutant stood still for good) - start it standing (state 1, STOP)
+            if (enemy->state == 0)
+            {
+                int32 a = level.models[enemy->type].animIndex;
+                for (int32 i = 0; i < 16; i++)          // its own animations (16 is well within any enemy model)
+                {
+                    if (level.anims[a + i].state == 1) {
+                        enemy->animSet(a + i, true);
+                        break;
+                    }
+                }
+            }
+            enemy->activate();
+        }
+    }
+
+    virtual void update()
+    {
+        if (state != STATE_EXPLODE)
+        {
+            Lara* lara = getLara(pos);
+            vec3i d = lara->pos - pos;
+            if (type == ITEM_MUTANT_EGG_BIG ||
+                (abs(d.x) < TRAP_EGG_RANGE && abs(d.y) < TRAP_EGG_RANGE && abs(d.z) < TRAP_EGG_RANGE))
+            {
+                hatch();
+            }
+        }
+        else if (animIsEnd(0))
+        {
+            deactivate();
+            return;
+        }
+        animProcess();
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if (state != STATE_EXPLODE) {
+            collideDefault(lara, cinfo);
+        }
+    }
+
+    virtual uint8* load(uint8* data)
+    {
+        data = ItemObj::load(data);
+        visibleMask = (state == STATE_EXPLODE) ? 0x1FF : 0xFFFE00;
+        if (state == STATE_EXPLODE) {
+            flags &= ~ITEM_FLAG_COLLISION;
+        }
+        return data;
+    }
+};
