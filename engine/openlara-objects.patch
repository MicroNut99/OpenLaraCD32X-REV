+// ------------------------------------------------------------------------- lightning
+struct Lightning : Object
+{
+    // hSpeed: frames to the next change, vSpeed: 1 = flash on
+    Lightning(Room* room) : Object(room)
+    {
+        hSpeed = 1;
+        vSpeed = 0;
+        flags &= ~ITEM_FLAG_COLLISION;
+    }
+
+    virtual void update()
+    {
+        if (!isActive())
+        {
+            hSpeed = 1;
+            vSpeed = 0;
+            if (gSaveGame.flipped) {
+                flipMap();
+            }
+            flags &= ~ITEM_FLAG_STATUS;
+            deactivate();
+            return;
+        }
+
+        if (--hSpeed > 0)
+            return;
+
+        if (vSpeed)                             // flash over
+        {
+            vSpeed = 0;
+            hSpeed = int16(35 + (rand_logic() * 45 >> 15));
+            if (gSaveGame.flipped) {
+                flipMap();
+            }
+        }
+        else                                    // flash
+        {
+            vSpeed = 1;
+            hSpeed = 20;
+
+            int32 radius = (level.models[type].count > 1) ? (5 * 1024 / 2) : 1024;
+            Lara* lara = getLara(pos);
+            vec3i d = lara->pos - pos;
+            if (lara->health > 0 && X_SQR(d.x >> 4) + X_SQR(d.z >> 4) < X_SQR(radius >> 4)) {
+                lara->hit(TRAP_LIGHTNING_DAMAGE, pos, 0);
+            }
+
+            if (!gSaveGame.flipped) {
+                flipMap();
+            }
+            soundPlay(SND_LIGHTNING, &pos);
+        }
+    }
+
+    virtual void draw()
