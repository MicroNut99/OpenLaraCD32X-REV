+struct ThorHammer : Object
+{
+    enum {
+        STATE_SET,
+        STATE_TEASE,
+        STATE_ACTIVE,
+        STATE_DONE
+    };
+
+    ThorHammer(Room* room) : Object(room)
+    {
+        extra = (uint8*)trapSpawn(ITEM_HAMMER_BLOCK, room, pos, angle.y, 0, intensity);
+        syncHead();
+    }
+
+    vec3i headPos() const
+    {
+        return pos + getBlockOffset(angle.y, -3 * 1024);
+    }
+
+    void syncHead()
+    {
+        ItemObj* head = (ItemObj*)extra;
+        if (!head)
+            return;
+        int32 headAnim = level.models[ITEM_HAMMER_BLOCK].animIndex;
+        int32 handleAnim = level.models[ITEM_HAMMER_HANDLE].animIndex;
+        head->animIndex = uint16(animIndex + headAnim - handleAnim);
+        head->frameIndex = uint16(frameIndex - level.anims[animIndex].frameBegin + level.anims[head->animIndex].frameBegin);
+        head->state = state;
+        head->pos = pos;
+        head->angle = angle;
+    }
+
+    virtual void update()
+    {
+        switch (state)
+        {
+            case STATE_SET:
+                if (isActive()) {
+                    goalState = STATE_TEASE;
+                } else {
+                    deactivate();
+                    flags &= ~ITEM_FLAG_STATUS;
+                }
+                break;
+
+            case STATE_TEASE:
+                goalState = isActive() ? STATE_ACTIVE : STATE_SET;
+                break;
+
+            case STATE_ACTIVE:
+            {
+                int32 frame = frameIndex - level.anims[animIndex].frameBegin;
+                if (frame > 30)
+                {
+                    vec3i p = headPos();
+                    Lara* lara = getLara(pos);
+                    if (lara->health > 0 && abs(lara->pos.x - p.x) < 520 && abs(lara->pos.z - p.z) < 520)
+                    {
+                        trapKill(lara);
+                        lara->angle.y = angle.y;
+                        lara->animSet(Lara::ANIM_DEATH_BOULDER, true);
+                        lara->flags &= ~ITEM_FLAG_GRAVITY;
+                        lara->vSpeed = 0;
+                        lara->hSpeed = 0;
+                    }
+                }
+                break;
+            }
+
+            case STATE_DONE:
+            {
+                updateRoom();
+                checkTrigger(gLastFloorData, NULL);
+
+                Lara* lara = getLara(pos);
+                if (lara->health > 0) {         // the head is a floor now
+                    vec3i p = headPos();
+                    trapAlterFloor(room, p.x, pos.y, p.z, -2 * 1024);
+                }
+                flags &= ~ITEM_FLAG_STATUS;
+                flags |= ITEM_FLAG_STATUS_INACTIVE;
+                deactivate();
+                break;
+            }
+        }
+
+        animProcess(false);
+        syncHead();
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        collideDefault(lara, cinfo);
+    }
+
+    virtual uint8* load(uint8* data)
+    {
+        data = ItemObj::load(data);
+        if (state == STATE_DONE && (flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INACTIVE)
+        {
+            vec3i p = headPos();
+            trapAlterFloor(room, p.x, pos.y, p.z, -2 * 1024);
+        }
+        syncHead();
+        return data;
+    }
+};
