+// ------------------------------------------------------------------------- Damocles swords
+struct TrapSword : Object
+{
+    // state / goalState: the drift x / z per frame (as TR1), turnSpeed: the spin
+    TrapSword(Room* room) : Object(room)
+    {
+        angle.y = int16(rand_logic() << 1);
+        turnSpeed = int16((rand_logic() - 0x4000) >> 4);
+        vSpeed = 50;
+        roomFloor = trapFloor(room, pos.x, pos.y, pos.z);
+    }
+
+    virtual void update()
+    {
+        if (flags & ITEM_FLAG_GRAVITY)
+        {
+            angle.y += turnSpeed;
+            vSpeed += (vSpeed < 128) ? GRAVITY : 1;
+            pos.y += vSpeed;
+            pos.x += int8(state);
+            pos.z += int8(goalState);
+
+            if (pos.y > roomFloor)
+            {
+                soundPlay(SND_SWORD, &pos);
+                pos.y = roomFloor + 10;
+                flags &= ~(ITEM_FLAG_GRAVITY | ITEM_FLAG_STATUS);
+                flags |= ITEM_FLAG_STATUS_INACTIVE;
+                deactivate();
+            }
+        }
+        else if (pos.y != roomFloor)
+        {
+            angle.y += turnSpeed;
+
+            Lara* lara = getLara(pos);
+            vec3i d = lara->pos - pos;
+
+            if (abs(d.x) <= TRAP_SWORD_RANGE && abs(d.z) <= TRAP_SWORD_RANGE && d.y > 0 && d.y < 3 * 1024)
+            {
+                state = uint8(int8(d.x >> 5));
+                goalState = uint8(int8(d.z >> 5));
+                flags |= ITEM_FLAG_GRAVITY;
+            }
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if (!collideBounds(lara, cinfo))
+            return;
+
+        if (cinfo->enemyPush) {
+            collidePush(lara, cinfo, false);
+        }
+
+        if (flags & ITEM_FLAG_GRAVITY)
+        {
+            lara->hit(TRAP_SWORD_DAMAGE, pos, 0);
+            trapBlood(lara, 1);
+        }
+    }
+};
