diff -ruN a/src/fixed/traps.h b/src/fixed/traps.h
--- a/src/fixed/traps.h	1969-12-31 16:00:00.000000000 -0800
+++ b/src/fixed/traps.h	2026-10-22 00:04:52.389862332 -0700
@@ -0,0 +1,1605 @@
+#ifndef H_TRAPS
+#define H_TRAPS
+
+/* ---------------------------------------------------------------------------------------
+ * OBJECTS-1: the TR1 objects the fixed engine left without behaviour, ported from the
+ *   original game's logic (TR1 / Tomb1Main) and the full OpenLara engine (src/objects.h).
+ *   Included at the end of object.h.  Also: flipmaps, trigger effects ("flipeffects"),
+ *   lava floors, Lara on fire.
+ *
+ *   Items that the original creates at level start (Thor's hammer head, the enemy inside a
+ *   mutant egg or a centaur statue) are made in the constructors, so they take the first
+ *   free item slots right after the level's items - the same slots after every level load.
+ *   gItemsCount counts them; the saved game stores them too (game.h).
+ * --------------------------------------------------------------------------------------- */
+
+#define TRAP_BOULDER_DAMAGE_AIR     100
+#define TRAP_SPIKES_DAMAGE          15
+#define TRAP_SLAM_DAMAGE            400
+#define TRAP_CEILING_DAMAGE         300
+#define TRAP_SWORD_DAMAGE           100
+#define TRAP_SWORD_RANGE            1536
+#define TRAP_LIGHTNING_DAMAGE       400
+#define TRAP_LAVA_SPEED             25
+#define TRAP_EGG_RANGE              4096
+#define TRAP_STATUE_RANGE           (3 * 1024 + 512)
+#define TRAP_FLAME_HEAT_DAMAGE      3
+#define TRAP_FLAME_BURN_DAMAGE      7
+
+int32 gItemsCount;                  // level items + the ones made at level start
+uint8 gFlipMaps[10];                // TR1 flipmap[]: trigger mask bits + once (bit 5)
+int32 gFlipEffect = -1;             // TR1 flipeffect / flip_timer
+int32 gFlipTimer;
+
+// a new item from the free list, with known flags (ItemObj::add leaves the old ones)
+// OBJECTS-1: a trap or object that starts invisible (bit 8 of its flags in the level) is shown and
+// started by its trigger, as TR1's TestTriggers does for every object that is not an enemy
+// (status = active). The engine kept such items invisible: no drawing and no collision.
+bool trapShowOnTrigger(int32 type)
+{
+    switch (type)
+    {
+        case ITEM_TRAP_SPIKES: case ITEM_TRAP_BOULDER: case ITEM_TRAP_SLAM: case ITEM_TRAP_SWORD:
+        case ITEM_TRAP_CEILING: case ITEM_HAMMER_HANDLE: case ITEM_HAMMER_BLOCK: case ITEM_LIGHTNING:
+        case ITEM_MOVING_OBJECT: case ITEM_MOVING_BLOCK: case ITEM_DRAWBRIDGE: case ITEM_CABIN:
+        case ITEM_BOAT: case ITEM_EARTHQUAKE: case ITEM_TRAP_LAVA: case ITEM_MIDAS_HAND:
+        case ITEM_FLAME_EMITTER: case ITEM_LAVA_EMITTER: case ITEM_CENTAUR_STATUE: case ITEM_SCION_HOLDER:
+        case ITEM_MUTANT_EGG_SMALL: case ITEM_MUTANT_EGG_BIG:
+        case ITEM_BLOCK_1: case ITEM_BLOCK_2: case ITEM_BLOCK_3: case ITEM_BLOCK_4:
+            return true;
+    }
+    return false;
+}
+
+ItemObj* trapSpawn(ItemType type, Room* room, const vec3i &p, int32 angleY, uint16 itemFlags, uint8 itemIntensity)
+{
+    ItemObj* item = ItemObj::sFirstFree;
+    if (!item)
+        return NULL;
+    ItemObj::sFirstFree = item->nextItem;
+
+    item->type = type;
+    item->pos = p;
+    item->angle.y = angleY;
+    item->intensity = itemIntensity;
+    item->flags = itemFlags;
+
+    return item->init(room);
+}
+
+// a sprite effect (explosion, flame burst) - smoke if the level has no explosion sprites
+void trapExplosion(Room* room, const vec3i &p)
+{
+    ItemType t = (level.models[ITEM_EXPLOSION].count < 0) ? ITEM_EXPLOSION : ITEM_SMOKE;
+    if (level.models[t].count >= 0)
+        return;
+    ItemObj* fx = trapSpawn(t, room, p, 0, 0, 128);
+    if (fx)
+    {
+        fx->timer = 2;
+        fx->flags |= ITEM_FLAG_ANIMATED;
+    }
+}
+
+// TR1 AlterFloorHeight: the floor of the sector under (x, y, z) up/down by offset
+void trapAlterFloor(Room* room, int32 x, int32 y, int32 z, int32 offset)
+{
+    Room* r = room->getRoom(x, y, z);
+    if (!r->modify()) return;           // no room left: never write the level data itself
+
+    Sector* sector = (Sector*)r->getSector(x, z);
+
+    if (sector->floor == NO_FLOOR) {
+        sector->floor = sector->ceiling + (offset >> 8);
+    } else {
+        sector->floor += (offset >> 8);
+        if (sector->floor == sector->ceiling) {
+            sector->floor = NO_FLOOR;
+        }
+    }
+}
+
+int32 trapFloor(Room* room, int32 x, int32 y, int32 z)
+{
+    Room* r = room->getRoom(x, y, z);
+    return r->getSector(x, z)->getFloor(x, y, z);
+}
+
+void trapBlood(Lara* lara, int32 count)
+{
+    for (int32 i = 0; i < count; i++)
+    {
+        vec3i p = lara->pos;
+        p.x += (rand_logic() - 0x4000) >> 7;
+        p.y -= rand_logic() >> 6;
+        p.z += (rand_logic() - 0x4000) >> 7;
+        lara->fxBlood(p, int16(rand_logic() << 1), lara->hSpeed);
+    }
+}
+
+void trapKill(Lara* lara)
+{
+    if (lara->health > 0) {
+        lara->hit(lara->health, lara->pos, 0);
+    }
+}
+
+struct Flame;
+void laraBurn(ItemObj* laraItem, bool kill);
+
+
+// ------------------------------------------------------------------------- flipmaps
+static void flipRoomItems(Room* room, int32 dir)  // TR1 Remove/AddRoomFlipItems
+{
+    for (ItemObj* item = room->firstItem; item; item = item->nextItem)
+    {
+        if ((item->flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INVISIBLE)
+            continue;
+
+        if (item->type >= ITEM_BLOCK_1 && item->type <= ITEM_BLOCK_4) {
+            ((Block*)item)->updateFloor(1024 * dir);
+        } else if (item->type == ITEM_MOVING_BLOCK && (item->flags & ITEM_FLAG_RAISED)) {
+            trapAlterFloor(item->room, item->pos.x, item->pos.y, item->pos.z, 2048 * dir);
+        }
+    }
+}
+
+Room* roomFlipPair(Room* room)                  // the other version of a flipmap room, or NULL
+{
+    int32 i = int32(room - rooms);
+    int32 alt = level.roomsInfo[i].alternateRoom;
+    if (alt != NO_ROOM && alt < level.roomsCount)
+        return rooms + alt;
+    for (int32 j = 0; j < level.roomsCount; j++)
+        if (level.roomsInfo[j].alternateRoom == i)
+            return rooms + j;
+    return NULL;
+}
+
+void flipMap()
+{
+    for (int32 i = 0; i < level.roomsCount; i++)
+    {
+        int32 alt = level.roomsInfo[i].alternateRoom;   // the level's own data: never swapped
+        if (alt == NO_ROOM || alt >= level.roomsCount)
+            continue;
+
+        Room* a = rooms + i;
+        Room* b = rooms + alt;
+
+        flipRoomItems(a, 1);
+
+        Room tmp = *a;
+        ItemObj* itemsA = a->firstItem;
+        ItemObj* itemsB = b->firstItem;
+        *a = *b;
+        *b = tmp;
+        a->firstItem = itemsA;      // the items stay in their room (index)
+        b->firstItem = itemsB;
+
+        flipRoomItems(a, -1);
+    }
+
+    gSaveGame.flipped ^= 1;
+}
+
+
+// ------------------------------------------------------------------------- effects
+void fxStart(int32 fx, ItemObj* item)
+{
+    Lara* lara = players[0];
+
+    switch (fx)
+    {
+        case FX_ROTATE_180:
+            if (item) item->angle.y += ANGLE_180;
+            break;
+
+        case FX_FLOOR_SHAKE:                // TR1 dino_stomp: a shake by the distance
+        {
+            if (!lara) break;
+            const vec3i &p = item ? item->pos : lara->pos;
+            vec3i d = p - lara->extraL->camera.view.pos;
+            int32 dist = phd_sqrt(X_SQR(d.x >> 4) + X_SQR(d.y >> 4) + X_SQR(d.z >> 4)) << 4;
+            if (dist < 16 * 1024) {
+                gCameraBounce = 100 * (16 * 1024 - dist) / (16 * 1024);
+            }
+            break;
+        }
+
+        case FX_LARA_NORMAL:
+            if (lara) lara->animSet(11, true);  // Lara::ANIM_STAND
+            break;
+
+        case FX_LARA_BUBBLES:
+            if (lara) lara->fxBubbles(lara->room, JOINT_HEAD, _vec3i(0, 0, 50));
+            break;
+
+        case FX_FINISH_LEVEL:
+            nextLevel(LevelID(gLevelID + 1));
+            break;
+
+        case FX_EARTHQUAKE:
+        case FX_FLOOD:
+        case FX_STAIRS2SLOPE:
+            gFlipEffect = fx;               // timed: fxUpdate
+            gFlipTimer = 0;
+            break;
+
+        case FX_EXPLOSION:
+            soundPlay(SND_EXPLOSION, NULL);
+            gCameraBounce = -75;
+            break;
+
+        case FX_LARA_HANDSFREE:
+            if (lara) lara->extraL->weaponState = WEAPON_STATE_FREE;
+            break;
+
+        case FX_FLIP_MAP:
+            flipMap();
+            break;
+
+        default: ;                          // cut-scene mesh swaps and guns: not here
+    }
+}
+
+void fxUpdate()                             // every logic frame: the timed effects
+{
+    if (gFlipEffect < 0)
+        return;
+
+    Lara* lara = players[0];
+
+    switch (gFlipEffect)
+    {
+        case FX_EARTHQUAKE:                 // TR1 earth_quake
+            if (gFlipTimer == 0) {
+                soundPlay(SND_EXPLOSION, NULL);
+                gCameraBounce = -250;
+            } else if (gFlipTimer == 3 || gFlipTimer == 35) {
+                soundPlay(SND_BOULDER, NULL);
+            } else if (gFlipTimer == 20 || gFlipTimer == 50 || gFlipTimer == 70) {
+                soundPlay(SND_STOMP, NULL);
+            }
+            if (++gFlipTimer >= 105) gFlipEffect = -1;
+            break;
+
+        case FX_FLOOD:                      // TR1 flood_fx
+            if (gFlipTimer == 0 && lara) {
+                soundPlay(SND_FLOOD, &lara->pos);
+            }
+            if (++gFlipTimer > 4 * 30) gFlipEffect = -1;
+            break;
+
+        case FX_STAIRS2SLOPE:
+            if (++gFlipTimer > 5) {
+                soundPlay(SND_STAIRS2SLOPE, NULL);
+                gFlipEffect = -1;
+            }
+            break;
+
+        default:
+            gFlipEffect = -1;
+    }
+}
+
+
+// ------------------------------------------------------------------------- flames
+struct Flame : ItemObj
+{
+    // timer >= 0: a fire on the ground (0 = ready to burn Lara, else frames to wait)
+    // timer < 0:  on Lara, at joint -1 - timer
+    Flame(Room* room) : ItemObj(room)
+    {
+        flags &= ~ITEM_FLAG_COLLISION;
+        frameIndex = 0;
+        timer = 0;
+        activate();
+    }
+
+    virtual void update()
+    {
+        int32 frames = -level.models[type].count;
+        if (frames > 0) {
+            frameIndex = (frameIndex + 1) % frames;
+        }
+
+        Lara* lara = getLara(pos);
+
+        if (timer < 0)
+        {
+            if (lara->waterState != WATER_STATE_ABOVE)    // in the water: out
+            {
+                remove();
+                return;
+            }
+            pos = lara->pos + lara->getJoint(-1 - timer, _vec3i(0, 0, 0));
+            if (room != lara->room) {
+                room->remove(this);
+                lara->room->add(this);
+            }
+            soundPlay(SND_FLAME, &pos);
+            lara->hit(TRAP_FLAME_BURN_DAMAGE, pos, 0);
+            return;
+        }
+
+        soundPlay(SND_FLAME, &pos);
+
+        if (timer > 0) {
+            timer--;
+            return;
+        }
+
+        if (lara->health <= 0)
+            return;
+
+        vec3i d = lara->pos - pos;
+        if (abs(d.x) < 600 && abs(d.z) < 600 && abs(d.y) < 600)
+        {
+            lara->hit(TRAP_FLAME_HEAT_DAMAGE, pos, 0);
+            if (X_SQR(d.x) + X_SQR(d.z) < X_SQR(300))
+            {
+                timer = 100;
+                laraBurn(lara, false);
+            }
+        }
+    }
+};
+
+void laraBurn(ItemObj* laraItem, bool kill)  // TR1 LaraBurn / Lava_Burn
+{
+    Lara* lara = (Lara*)laraItem;
+
+    if (lara->waterState != WATER_STATE_ABOVE)
+        return;
+    if (level.models[ITEM_FLAME].count >= 0)    // no flame sprites in this level
+    {
+        if (kill) trapKill(lara);
+        return;
+    }
+
+    int32 count = kill ? 10 : 1;
+    for (int32 i = 0; i < count; i++)
+    {
+        int32 joint = kill ? (rand_logic() % 15) : 0;
+        ItemObj* flame = trapSpawn(ITEM_FLAME, lara->room, lara->pos, 0, 0, 128);
+        if (flame) {
+            flame->timer = int16(-1 - joint);
+        }
+    }
+
+    if (kill) {
+        trapKill(lara);
+    }
+}
+
+struct FlameEmitter : Object
+{
+    FlameEmitter(Room* room) : Object(room)
+    {
+        flags &= ~ITEM_FLAG_COLLISION;
+    }
+
+    virtual void update()
+    {
+        ItemObj* flame = (ItemObj*)extra;
+
+        if (isActive())
+        {
+            if (!flame) {
+                extra = (uint8*)trapSpawn(ITEM_FLAME, room, pos, 0, 0, 128);
+            }
+        }
+        else if (flame)
+        {
+            flame->remove();
+            extra = NULL;
+            deactivate();
+        }
+    }
+
+    virtual void draw() {}
+};
+
+
+// ------------------------------------------------------------------------- boulder
+struct TrapBoulder : Object
+{
+    enum {
+        STATE_SET,
+        STATE_ROLL
+    };
+
+    TrapBoulder(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        uint16 status = flags & ITEM_FLAG_STATUS;
+
+        if (status == ITEM_FLAG_STATUS_ACTIVE)
+        {
+            if (pos.y < roomFloor)
+            {
+                if (!(flags & ITEM_FLAG_GRAVITY))
+                {
+                    flags |= ITEM_FLAG_GRAVITY;
+                    vSpeed = -10;
+                }
+            }
+            else if (state == STATE_SET)
+            {
+                goalState = STATE_ROLL;
+            }
+
+            vec3i old = pos;
+
+            animProcess();
+            updateRoom();
+            checkTrigger(gLastFloorData, NULL);
+
+            if (pos.y >= roomFloor - 256)
+            {
+                flags &= ~ITEM_FLAG_GRAVITY;
+                vSpeed = 0;
+                pos.y = roomFloor;
+            }
+
+            int32 s, c;
+            sincos(angle.y, s, c);
+            int32 x = pos.x + (512 * s >> FIXED_SHIFT);
+            int32 z = pos.z + (512 * c >> FIXED_SHIFT);
+
+            if (trapFloor(room, x, pos.y, z) < pos.y)   // a wall ahead: stop
+            {
+                flags &= ~(ITEM_FLAG_STATUS | ITEM_FLAG_GRAVITY);
+                flags |= ITEM_FLAG_STATUS_INACTIVE;
+                pos.x = old.x;
+                pos.z = old.z;
+                hSpeed = 0;
+                vSpeed = 0;
+                hitMask = 0;
+            }
+        }
+        else if (status == ITEM_FLAG_STATUS_INACTIVE && !isActive())
+        {
+            int32 index = int32((ItemObj*)this - items); // back to the start
+            if (index < level.itemsCount)
+            {
+                const ItemObjInfo* info = level.itemsInfo + index;
+                Room* start = rooms + info->roomIndex;
+                pos.x = info->pos.x + (start->info->x << 8);
+                pos.y = info->pos.y;
+                pos.z = info->pos.z + (start->info->z << 8);
+                if (room != start) {
+                    room->remove(this);
+                    start->add(this);
+                }
+            }
+            animSet(level.models[type].animIndex, true);
+            flags &= ~ITEM_FLAG_STATUS;
+            deactivate();
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_ACTIVE)
+        {
+            if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE) {
+                collideDefault(lara, cinfo);
+            }
+            return;
+        }
+
+        if (lara->health <= 0)
+            return;
+
+        if (!updateHitMask(lara, cinfo))
+            return;
+
+        if (lara->flags & ITEM_FLAG_GRAVITY)            // in the air: knocked
+        {
+            if (cinfo->enemyPush) {
+                collidePush(lara, cinfo, true);
+            }
+            lara->hit(TRAP_BOULDER_DAMAGE_AIR, pos, 0);
+            trapBlood(lara, 1);
+        }
+        else                                            // on the ground: run over
+        {
+            trapKill(lara);
+            if (lara->room != room) {
+                lara->room->remove(lara);
+                room->add(lara);
+            }
+            lara->angle.x = 0;
+            lara->angle.y = angle.y;
+            lara->angle.z = 0;
+            lara->animSet(Lara::ANIM_DEATH_BOULDER, true);
+            lara->flags &= ~ITEM_FLAG_GRAVITY;
+            lara->vSpeed = 0;
+            lara->hSpeed = 0;
+            trapBlood(lara, 15);
+        }
+    }
+};
+
+
+// ------------------------------------------------------------------------- spikes
+struct TrapSpikes : Object
+{
+    TrapSpikes(Room* room) : Object(room) {}
+
+    virtual void update() {}
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if (lara->health <= 0)
+            return;
+
+        if (!updateHitMask(lara, cinfo))
+            return;
+
+        int32 num = rand_logic() / 24576;
+
+        if (lara->flags & ITEM_FLAG_GRAVITY)
+        {
+            if (lara->vSpeed > 0)               // fell onto them
+            {
+                lara->hit(lara->health, pos, 0);
+                num = 20;
+            }
+        }
+        else if (abs(lara->hSpeed) < 30)        // walking carefully: nothing
+        {
+            return;
+        }
+
+        lara->hit(TRAP_SPIKES_DAMAGE, pos, 0);
+        trapBlood(lara, num);
+
+        if (lara->health <= 0)
+        {
+            lara->animSet(Lara::ANIM_DEATH_SPIKES, true);
+            lara->pos.y = pos.y;
+            lara->flags &= ~ITEM_FLAG_GRAVITY;
+            lara->vSpeed = 0;
+        }
+    }
+};
+
+
+// ------------------------------------------------------------------------- slamming doors
+struct TrapSlam : Object
+{
+    enum {
+        STATE_OPEN,
+        STATE_SLAM
+    };
+
+    TrapSlam(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        if (isActive())
+        {
+            goalState = STATE_SLAM;
+            if (hitMask && state == STATE_SLAM)
+            {
+                Lara* lara = getLara(pos);
+                lara->hit(TRAP_SLAM_DAMAGE, pos, 0);
+                trapBlood(lara, 2);
+            }
+        }
+        else
+        {
+            goalState = STATE_OPEN;
+        }
+        hitMask = 0;
+
+        animProcess();
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if ((flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_ACTIVE) {
+            updateHitMask(lara, cinfo);
+        } else if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE) {
+            collideDefault(lara, cinfo);
+        }
+    }
+};
+
+
+// ------------------------------------------------------------------------- falling ceiling
+struct TrapCeiling : Object
+{
+    enum {
+        STATE_SET,
+        STATE_FALL,
+        STATE_DOWN
+    };
+
+    TrapCeiling(Room* room) : Object(room) {}
+
+    virtual void update()
+    {
+        if (state == STATE_SET)
+        {
+            goalState = STATE_FALL;
+            flags |= ITEM_FLAG_GRAVITY;
+        }
+        else if (state == STATE_FALL && hitMask)
+        {
+            Lara* lara = getLara(pos);
+            lara->hit(TRAP_CEILING_DAMAGE, pos, 0);
+        }
+        hitMask = 0;
+
+        animProcess();
+
+        if ((flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_INACTIVE)
+        {
+            deactivate();
+            return;
+        }
+
+        updateRoom();
+
+        if (state == STATE_FALL && pos.y >= roomFloor)
+        {
+            goalState = STATE_DOWN;
+            pos.y = roomFloor;
+            vSpeed = 0;
+            flags &= ~ITEM_FLAG_GRAVITY;
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if ((flags & ITEM_FLAG_STATUS) == ITEM_FLAG_STATUS_ACTIVE) {
+            updateHitMask(lara, cinfo);
+        } else if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE) {
+            collideDefault(lara, cinfo);
+        }
+    }
+};
