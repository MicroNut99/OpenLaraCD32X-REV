+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        collideDefault(lara, cinfo);
+
+        if (lara->health <= 0 || (lara->flags & ITEM_FLAG_GRAVITY) || lara->state != Lara::STATE_STOP)
+            return;
+
+        vec3i d = lara->pos - pos;
+
+        if (abs(d.x) < 512 && abs(d.z) < 512)   // on its sector: turned to gold
+        {
+            trapKill(lara);
+            lara->animSet(level.models[ITEM_LARA_SPEC].animIndex + 1, true);
+            lara->flags &= ~ITEM_FLAG_GRAVITY;
+            lara->vSpeed = 0;
+            lara->hSpeed = 0;
+            lara->extraL->weaponState = WEAPON_STATE_BUSY;
+            return;
+        }
+
+        if (abs(d.x) >= 700 || abs(d.z) >= 700)
+            return;
+
+        if (lara->extraL->weaponState != WEAPON_STATE_FREE)
+            return;
+
+        if (!(lara->input & IN_ACTION) && (inventory.useSlot == SLOT_MAX))
+            return;
+
+        if (inventory.useSlot == SLOT_MAX)
+        {
+            if (inventory.numKeys > 0) {
+                inventory.open(lara, INV_PAGE_USE, type);
+                return;
+            }
+        }
+        else if (inventory.useSlot == SLOT_LEADBAR)
+        {
+            inventory.remove(SLOT_LEADBAR, 1);
+            inventory.useSlot = SLOT_MAX;
+            inventory.add(ITEM_PUZZLE_1);
+
+            lara->angle.y = ANGLE_90;
+            lara->pos.x = pos.x - 612;
+            lara->animSet(level.models[ITEM_LARA_SPEC].animIndex, true);
+            lara->extraL->weaponState = WEAPON_STATE_BUSY;
+            return;
+        }
+        else
+        {
+            inventory.useSlot = SLOT_MAX;
+        }
+
+        soundPlay(SND_NO, &lara->pos);
+    }
+};
