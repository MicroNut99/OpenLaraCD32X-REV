+struct ScionTarget : Object                 // Atlantis: shoot the Scion
+{
+    // hSpeed: frames since it was destroyed
+    ScionTarget(Room* room) : Object(room)
+    {
+        health = 5;
+        hSpeed = 0;
+        if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE)
+        {
+            flags &= ~ITEM_FLAG_STATUS;
+            flags |= ITEM_FLAG_STATUS_ACTIVE;
+            activate();
+        }
+    }
+
+    virtual void hit(int32 damage, const vec3i &point, int32 soundId)
+    {
+        if (health > 0) {
+            health -= damage;
+        }
+    }
+
+    virtual void update()
+    {
+        if (health > 0)
+        {
+            hSpeed = 0;
+            animProcess();
+            return;
+        }
+
+        if (hSpeed == 0)
+        {
+            flags &= ~ITEM_FLAG_STATUS;
+            flags |= ITEM_FLAG_STATUS_INVISIBLE;
+            updateRoom();
+            checkTrigger(gLastFloorData, NULL);     // the level's end is under it
+        }
+
+        if (hSpeed % 10 == 0)
+        {
+            vec3i p = pos;
+            p.x += (rand_logic() - 0x4000) >> 6;
+            p.y -= 256 + (rand_logic() >> 6);
+            p.z += (rand_logic() - 0x4000) >> 6;
+            trapExplosion(room, p);
+            soundPlay(SND_EXPLOSION, &pos);
+            gCameraBounce = -200;
+        }
+
+        if (++hSpeed >= 3 * 30) {
+            deactivate();
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo)
+    {
+        if ((flags & ITEM_FLAG_STATUS) != ITEM_FLAG_STATUS_INVISIBLE) {
+            collideDefault(lara, cinfo);
+        }
+    }
+};
+
+// ------------------------------------------------------------------------- projectiles
+struct Missile : ItemObj                    // mutant shards, centaur bombs, Natla's bolts
+{
+    // health: the damage, timer: frames left, hSpeed / vSpeed: set by Enemy::fire
+    Missile(Room* room) : ItemObj(room)
+    {
+        flags &= ~ITEM_FLAG_COLLISION;
+        timer = 4 * 30;
+        activate();
+    }
+
+    void impact(bool hitLara)
+    {
+        if (type == ITEM_CENTAUR_BULLET)
+        {
+            trapExplosion(room, pos);
+            soundPlay(SND_EXPLOSION, &pos);
+        }
+        else if (!hitLara)
+        {
+            fxRicochet(room, pos, true);
+        }
+        remove();
+    }
+
+    virtual void update()
+    {
+        int32 s, c;
+        sincos(angle.y, s, c);
+        pos.x += hSpeed * s >> FIXED_SHIFT;
+        pos.z += hSpeed * c >> FIXED_SHIFT;
+        pos.y += vSpeed;
+
+        Room* r = room->getRoom(pos.x, pos.y, pos.z);
+        if (r != room)
+        {
+            room->remove(this);
+            r->add(this);
+        }
+
+        const Sector* sector = room->getSector(pos.x, pos.z);
+        if (--timer <= 0 ||
+            pos.y >= sector->getFloor(pos.x, pos.y, pos.z) ||
+            pos.y <= sector->getCeiling(pos.x, pos.y, pos.z))
+        {
+            impact(false);
+            return;
+        }
+
+        Lara* lara = getLara(pos);
+        if (lara->health > 0)
+        {
+            int32 dx = lara->pos.x - pos.x;
+            int32 dy = (lara->pos.y - 512) - pos.y;
+            int32 dz = lara->pos.z - pos.z;
+            if (abs(dx) < 200 && abs(dz) < 200 && abs(dy) < 512)
+            {
+                lara->hit(health, pos, 0);
+                lara->fxBlood(pos, angle.y, 0);
+                impact(true);
+            }
+        }
+    }
+};
+
+
+// ------------------------------------------------------------------------- lava fountains
+#define LAVA_PARTICLES_MAX  8
+
+int32 gLavaParticles;
+
+struct LavaParticle : ItemObj               // Natla's Mines, Atlantis, The Great Pyramid
+{
+    LavaParticle(Room* room) : ItemObj(room)
+    {
+        flags &= ~ITEM_FLAG_COLLISION;
+        int32 frames = -level.models[type].count;
+        frameIndex = (frames > 0) ? (rand_draw() % frames) : 0;
+        angle.y = int16(rand_logic() << 1);
+        hSpeed = int16(rand_logic() >> 10);
+        vSpeed = int16(-(rand_logic() / 200));
+        gLavaParticles++;
+        activate();
+    }
+
+    void kill()
+    {
+        gLavaParticles--;
+        remove();
+    }
+
+    virtual void update()
+    {
+        int32 s, c;
+        sincos(angle.y, s, c);
+        pos.x += hSpeed * s >> FIXED_SHIFT;
+        pos.z += hSpeed * c >> FIXED_SHIFT;
+        vSpeed += GRAVITY;
+        pos.y += vSpeed;
+
+        Room* r = room->getRoom(pos.x, pos.y, pos.z);
+        if (r != room)
+        {
+            room->remove(this);
+            r->add(this);
+        }
+
+        const Sector* sector = room->getSector(pos.x, pos.z);
+        if (pos.y >= sector->getFloor(pos.x, pos.y, pos.z) || pos.y < sector->getCeiling(pos.x, pos.y, pos.z))
+        {
+            kill();
+            return;
+        }
+
+        Lara* lara = getLara(pos);
+        if (lara->health > 0)
+        {
+            int32 dx = lara->pos.x - pos.x;
+            int32 dy = (lara->pos.y - 384) - pos.y;
+            int32 dz = lara->pos.z - pos.z;
+            if (abs(dx) < 200 && abs(dz) < 200 && abs(dy) < 512)
+            {
+                lara->hit(10, pos, 0);
+                kill();
+            }
+        }
+    }
+};
+
+struct LavaFountain : Object
+{
+    LavaFountain(Room* room) : Object(room)
+    {
+        flags &= ~ITEM_FLAG_COLLISION;
+    }
+
+    virtual void update()
+    {
+        if (!isActive() || level.models[ITEM_LAVA_PARTICLE].count >= 0)
+            return;
+
+        Lara* lara = getLara(pos);
+        vec3i d = lara->pos - pos;
+        if (abs(d.x) > 10 * 1024 || abs(d.z) > 10 * 1024 || abs(d.y) > 6 * 1024)
+            return;                         // out of sight: no items spent on it
+
+        soundPlay(SND_LAVA, &pos);
+
+        if (gLavaParticles < LAVA_PARTICLES_MAX && rand_logic() < 0x4000) {
+            trapSpawn(ITEM_LAVA_PARTICLE, room, pos, 0, 0, 255);
+        }
+    }
+
+    virtual void draw() {}
+};
+
+#endif
