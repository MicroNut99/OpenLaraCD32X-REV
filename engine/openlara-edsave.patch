@@ -469,6 +582,15 @@ static uint32 csPieceBase(int32 piece)
     return (piece & CS_SLOT_PIECE) ? CS_SLOTS + uint32(piece & 31) * CS_PIECE : CS_SET + uint32(piece) * CS_PIECE;
 }
 
