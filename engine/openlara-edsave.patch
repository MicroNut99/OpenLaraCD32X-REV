+/* ---------------------------------------------------------------------------------------
+ * EDSAVE-1 (CART=ED builds, CD32X_CART_ED): the Mega EverDrive PRO wipes its PSRAM - the whole
+ *   RAM cart - every time its menu runs, so a save there never outlived the session.  Its bank
+ *   31 is battery RAM that the EverDrive OS keeps on the SD card (bram.srm); the cartridge-boot
+ *   Sub-CPU (EDSAVE=1) puts the save area and the slots there, with the same piece numbers.
+ *   The SH2 cannot see that bank, so every read of a save piece goes through the Sub-CPU:
+ *   CMD 62 brings the piece into its 4 KB buffer, CMD 57 hands out its words.  Writes were
+ *   through the Sub-CPU already (CMD 58 + 61).  CMD 62 with COMM2 = 0x8000 only asks: bit 9
+ *   set = the saves are in the bank (gSaveBank 1), else the cart is read directly as before.
+ * --------------------------------------------------------------------------------------- */
+#ifndef CD32X_CART_ED
+#define CD32X_CART_ED 0
+#endif
+#define CS_CMD_GET      57
+#define CS_CMD_PIECE_IN 62
+static int32 gSaveBank = CD32X_CART_ED ? -1 : 0;   /* -1 not asked yet, 0 the cart, 1 the bank */
+static int32 rdPiece = -1;                         /* the piece in the Sub-CPU's buffer */
+static int32 csPieceOf(uint32 ofs);
+static uint32 csPieceBase(int32 piece);
+
+/* EDSAVE-2/4: the slave SH2 parked for a save command - first (EDSAVE-2) only between commands with
+   its mixer stopped, which was not enough: it still fetched its idle loop from the cart.  Now
+   (EDSAVE-4) it goes into the SDRAM loop (MARS_CMD_PARK, acknowledged with PARK_ACK) and the master
+   issues the command only once it is there; csUnpark lets it out (COMM4 = 0).  Nested, so a run of
+   commands parks once.  Its sound DMA keeps running (it reads SDRAM); its interrupt waits. */
+static int32 csParkDepth = 0;
+static void csPark()
+{
+    if (csParkDepth++ == 0)
+    {
+        MARS_WAIT();                             /* the slave between commands */
+        MARS_SYS_COMM4 = MARS_CMD_PARK;
+        while (MARS_SYS_COMM4 != MARS_CMD_PARK_ACK) marsIdle();   /* ... and in SDRAM */
+    }
+}
+static void csUnpark()
+{
+    if (--csParkDepth == 0) MARS_SYS_COMM4 = 0;
+}
+
+static void saveBankQuery()
+{
+    MARS_SYS_COMM2 = 0x8000;
+    CD_COMM12_16 = 0;
+    cdCmd(CS_CMD_PIECE_IN);
+    gSaveBank = (CD_COMM12_16 & 0x200) ? 1 : 0;
+}
+
+static void saveBankRead(uint32 ofs, uint8* dst, int32 len)            /* ofs even */
+{
+    while (len > 0)
+    {
+        int32 piece = csPieceOf(ofs);
+        uint32 base = csPieceBase(piece);
+        int32 o = int32(ofs - base);
+        int32 n = (len < 4096 - o) ? len : (4096 - o);
+        if (piece != rdPiece)
+        {
+            MARS_SYS_COMM2 = (uint16)piece;
+            csPark();                            /* EDSAVE-2/4 */
+            cdCmdSafe(CS_CMD_PIECE_IN);
+            csUnpark();
+            rdPiece = piece;
+        }
+        for (int32 i = 0; i < n; i += 2)
+        {
+            MARS_SYS_COMM2 = (uint16)((o + i) >> 1);
+            cdCmd(CS_CMD_GET);
+            uint16 w = MARS_SYS_COMM8;
+            dst[i] = (uint8)(w >> 8);
+            if (i + 1 < n) dst[i + 1] = (uint8)w;
+        }
+        ofs += n; dst += n; len -= n;
+    }
+}
