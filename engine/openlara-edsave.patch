+/* EDSAVE-4 (edsave3, console, 26 Oct 2026): on the Mega EverDrive PRO an SH2's cart access while the
+   68000 holds RV = 1 is NOT held until RV = 0 - it is answered at once with garbage (the slave read
+   ~100% bad words through every such copy, the master too; code fetched that way ran).  So for every
+   command whose 68000 side copies with RV = 1 (46: a level chunk, 61/62: the save bank) both SH2s sit
+   in a loop that lives in SDRAM (.data.sdram) with their interrupts masked: nothing fetches or reads
+   the cart until the Sub-CPU says the copy is over.  This is why the passport froze in the game and
+   not at the title: in the game the cache is cold and the master's poll loop or its vblank handler
+   got fetched from the cart during a copy. */
+#define MARS_CMD_PARK         0x7A60        /* slave: into the SDRAM loop, answer PARK_ACK in COMM4 */
+#define MARS_CMD_PARK_ACK     0x7A61        /*        ... and stay there while COMM4 == PARK_ACK  */
+
+__attribute__((section(".data.sdram"), noinline))
+static void csSpin(volatile uint16* reg, uint16 value, int32 whileEqual, uint16 ack)
+{   /* runs from SDRAM: interrupts masked, spin while (*reg == value) == whileEqual.  No calls, no
+       cart data: this function and its stack are the only memory touched.  ack != 0: write it to
+       *reg first (the slave: "I am in SDRAM now"). */
+    uint32 sr, masked;
+    __asm__ volatile ("stc sr,%0" : "=r"(sr));
+    masked = sr | 0xF0u;
+    __asm__ volatile ("ldc %0,sr" : : "r"(masked));
+    if (ack) *reg = ack;
+    for (int32 n = 0; n < 4000000; n++)
+    {
+        if (((*reg == value) ? 1 : 0) != whileEqual) break;
+        for (volatile int32 k = 0; k < 64; k++) {}    /* hardware rule: never hammer a COMM register */
+    }
+    __asm__ volatile ("ldc %0,sr" : : "r"(sr));
+}
+
+static void cdCmdSafe(uint16 cmd)                    /* a command whose 68000 side holds RV = 1 */
+{
+    MARS_SYS_COMM0 = cmd;
+    csSpin(&MARS_SYS_COMM0, 0, 0, 0);                /* from SDRAM until COMM0 == 0 */
+}
