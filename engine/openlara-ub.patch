+#ifdef CD32X
+int32 Nav::randomBox(int32 n) const     // UB-1: the n-th box of the zone (as cells[n].boxIndex was)
+{
+    for (int32 w = 0; w < (level.boxesCount + 31) >> 5; w++)
+    {
+        uint32 bits = member[w];
+        int32 c = __builtin_popcount(bits);
+        if (n >= c)                         // not in this word: 32 boxes at a time
+        {
+            n -= c;
+            continue;
+        }
+        for (int32 b = 0; ; b++, bits >>= 1)
+        {
+            if ((bits & 1) && (n-- == 0))
+                return (w << 5) + b;
+        }
+    }
+    return 0;
+}
