+static const uint8* picLoad(int32 n)
+{
+    MARS_SYS_COMM2 = (uint16)n;
+    cdCmd(CD_CMD_OPEN_FILE);
+    if (MARS_SYS_COMM0 != 0)
+        return NULL;
+    int32 len = (int32)CD_COMM8_32;
+    if (len != PIC_SIZE)
+        return NULL;
+    for (uint32 c = 0; c < ((uint32)len + 32767) >> 15; c++)
+    {
+        MARS_SYS_COMM2 = (uint16)(c | 0x8000);     /* no read-back */
+        CD_COMM12_16 = 0;
+        cdCmd(CD_CMD_CHUNK_TO_CART);
+        if (MARS_SYS_COMM0 != 0 || CD_COMM12_16 != 0)
+            return NULL;
+    }
+    return (const uint8*)((0x02000000 + ((uint32)n << 17)) | 0x20000000);   /* read cache-through */
+}
