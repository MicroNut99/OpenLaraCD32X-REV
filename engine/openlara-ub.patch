+/* PICS-1: the end credits - the PC game's pictures, full screen, each until A, B, C or Start or
+   for a while: CRED1-3 and THE END after the Great Pyramid, Unfinished Business's own page
+   (CRED0) first after The Hive.  IMAGE23-27.RAW (tools/make_ol_pictures.py); a page not on the
+   disc is skipped. */
+void osCredits(bool ub)
+{
+    static const uint8 tr1[] = { 23, 24, 25, 26 };
+    static const uint8 ubp[] = { 27, 23, 24, 25, 26 };
+    const uint8* list = ub ? ubp : tr1;
+    int32 count = ub ? int32(sizeof(ubp)) : int32(sizeof(tr1));
+
+    sfxBankStop();
+    MARS_SYS_COMM2 = 0;                         /* music off - no CD data reads while it plays */
+    cdCmd(54);
+    MARS_WAIT();
+    gCartLevel = -1;                            /* the pictures go into the level slot */
+    int32 rate = (MARS_VDP_DISPMODE & MARS_NTSC_FORMAT) ? 60 : 50;
+    bool shown = false;
+    for (int32 i = 0; i < count; i++)
+    {
+        const uint8* pic = picLoad(list[i]);
+        if (!pic)
+            continue;
+        gSplashPic = pic;
+        gSplashNoBar = true;
+        splashBegin();                          /* both buffers, the picture's colours */
+        shown = true;
+        int32 secs = (list[i] == 26) ? 6 : 10;  /* THE END: a little shorter */
+        int32 t0 = *(volatile int32*)&gFrameIndex;
+        int32 prev = 0xFFFF, pad = 0xFFFF;      /* buttons already held don't count */
+        int32 last = -1;
+        while (*(volatile int32*)&gFrameIndex - t0 < secs * rate)
+        {
+            int32 now = *(volatile int32*)&gFrameIndex;
+            if (now == last)                    /* the pad once a frame (the Sub-CPU's COMM) */
+            {
+                cdPause();
+                continue;
+            }
+            last = now;
+            pad = fmvPad(pad);
+            int32 hit = pad & ~prev;
+            prev = pad;
+            if (hit & (SEGA_CTRL_A | SEGA_CTRL_B | SEGA_CTRL_C | SEGA_CTRL_START))
+                break;
+            cdPause();
+        }
+    }
+    if (shown)
+        splashEnd();                            /* black, the game's palette back */
+    gSplashPic = NULL;
+    gSplashNoBar = false;
+    sfxBankStart();
+}
