+#ifdef CD32X
+/* ---------------------------------------------------------------------------------------
+ * OL-4: CD audio (CDDA) on the Sega CD.  The engine asks for the ORIGINAL game's track
+ * numbers; the disc is laid out so that disc track N = game track N (tools/make_music_tracks.py,
+ * music_map.txt - numbers without music are 2 s of silence).  The Sub-CPU plays them:
+ *   CMD 45, COMM2 = track         -> BIOS MSCPLAYR (repeat)  - title music and ambience
+ *   CMD 45, COMM2 = track | 0x8000 -> BIOS MSCPLAY1 (once)    - every other cue
+ *   CMD 54                         -> BIOS MSCSTOP
+ * Rule: no CD data reads while music plays - osLoadLevel() stops the music first.
+ * --------------------------------------------------------------------------------------- */
+#include "32x.h"
+
+#define SND_CMD_PLAY        45
+#define SND_CMD_STOP        54
+#define SND_TRACK_FIRST     2
+#define SND_TRACK_LAST      80      /* OL-11: 60 + level = the level's own music */
+#define SND_COMM14          (*(volatile uint16 *)0x2000402E)   /* Sub-CPU: drive status nibble */
+
+static void sndCmd(uint16 cmd)
+{
+    MARS_SYS_COMM0 = cmd;
+    for (int32 n = 0; n < 2000000 && MARS_SYS_COMM0 != 0; n++)
+        for (volatile int32 k = 0; k < 64; k++) {}
+}
+
+static bool sndLoops(int32 track)
+{
+    return (track >= 2 && track <= 5) || (track >= 57);   /* title, ambience, level music */
+}
+
+void sndInit() {}
+void sndInitSamples() {}
+void sndFreeSamples() {}
+/* OL-6: one sound effect per frame goes to the Sub-CPU with the pad request (the loudest);
+   the number is the engine's sample index + 1, the Sub-CPU maps it to the level's PCM pack */
+static int32 sndPending = 0;
+static int32 sndPendingVol = 0;
+
+void* sndPlaySample(int32 index, int32 volume, int32 pitch, int32 mode)
+{
+    if (index < 0 || index > 253)
+        return NULL;
+    if (!sndPending || volume > sndPendingVol)
+    {
+        sndPending = index + 1;
+        sndPendingVol = volume;
+    }
+    return NULL;
+}
+
+/* SFXVOL-1: the pending effect's volume (1-64, 64 = full; soundPlay() already lowers it
+   with the distance to the camera).  main.cpp sends it in COMM2 with the pad request. */
+int32 sndPendingVolume()
+{
+    return sndPending ? X_CLAMP(sndPendingVol, 1, 64) : 0;
+}
+
+int32 sndTakePending()
+{
+    int32 p = sndPending;
+    sndPending = 0;
+    return p;
+}
+
+/* OL-10: what the SH2 started (the engine asks "still playing?" every frame) */
+static int32 sndTrack = 0;          /* 0 = none */
+static int32 sndCutLevel = -1;      /* CUTAUDIO-1: the cut-scene whose sound has started */
+static int32 sndGrace = 0;          /* frames a play-once cue counts as playing regardless */
+
+void sndPlayTrack(int32 track)
+{
+    /* CUTAUDIO-1: a cut-scene's sound (game tracks 22-25, voices + music from the game CD) -
+       once per visit: when it has ended the engine asks again, then nothing more plays.
+       PASSPORT-3: in a cut-scene level ANY request means its own track (the level table has
+       none for them); anywhere else 22-25 are ignored (rule below: cues 6-56) */
+    int32 cut = 0;
+    switch (gLevelID)
+    {
+        case LVL_TR1_CUT_1: cut = TRACK_TR1_CUT_1; break;     /* 23 Qualopec      */
+        case LVL_TR1_CUT_2: cut = TRACK_TR1_CUT_2; break;     /* 25 Tihocan       */
+        case LVL_TR1_CUT_3: cut = TRACK_TR1_CUT_3; break;     /* 24 Natla's Mines */
+        case LVL_TR1_CUT_4: cut = TRACK_TR1_CUT_4; break;     /* 22 Atlantis      */
+        default: break;
+    }
+    if (cut)
+    {
+        track = cut;
+        if (sndCutLevel == int32(gLevelID))
+            return;
+        sndCutLevel = int32(gLevelID);
+        MARS_SYS_COMM2 = (uint16)(track | 0x8000);
+        sndCmd(SND_CMD_PLAY);
+        sndTrack = track;
+        sndGrace = 180;
+        return;
+    }
+
+    /* OL-11/12: any ambience request - including "none" (-1) - plays the level's own music
+       (disc track 60 + level); trigger cues 6-56 have no album music (except 13, the secret
+       chime) and are ignored, so the level music is not interrupted */
+    if (track < 2 || track == 5 || (track >= 57 && track <= 59))
+    {
+        if (int32(gLevelID) < 0 || int32(gLevelID) > 20)
+            return;
+        track = 60 + int32(gLevelID);
+    }
+    else if (track >= 6 && track <= 56 && track != 13)
+        return;
+    if (track < SND_TRACK_FIRST || track > SND_TRACK_LAST)
+        return;
