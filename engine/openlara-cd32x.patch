+struct Natla : Human
+{
+    // ENEMIES-2: Natla.  Stage 1 (health above 200): flies when she cannot shoot you, lands and
+    // fires three bolts.  At 200 she faints; after a while she gets up for stage 2: she runs
+    // and keeps shooting until she dies.
+    enum {
+        N_NONE,
+        N_STOP,
+        N_FLY,
+        N_RUN,
+        N_AIM,
+        N_FAINT,
+        N_FIRE,
+        N_FALL,
+        N_STAND,
+        N_DEATH
+    };
+
+    enum {
+        HALF_HEALTH  = 200,
+        FAINT_HEALTH = -8192,
+        WAKE_CHANCE  = 68           // ~16 s of fainting on average
+    };
+
+    Natla(Room* room) : Human(room, 400, 204) {}
+
+    void fly(bool on)
+    {
+        extraE->nav.stepHeight = on ? 256 * 80 : 256;
+        extraE->nav.dropHeight = on ? -256 * 80 : -256;
+        extraE->nav.vSpeed = on ? 16 : 0;
+    }
+
+    virtual int32 updateState()
+    {
+        if (health <= 0)
+        {
+            if (health == FAINT_HEALTH)                 // fainted, not dead
+            {
+                fly(false);
+                if (state == N_FALL) {
+                    if (pos.y < roomFloor) {
+                        flags |= ITEM_FLAG_GRAVITY;
+                        return N_FALL;
+                    }
+                    flags &= ~ITEM_FLAG_GRAVITY;
+                    pos.y = roomFloor;
+                    return N_FAINT;
+                }
+                if (state == N_FAINT && rand_logic() < WAKE_CHANCE) {
+                    health = HALF_HEALTH;
+                    return N_STAND;
+                }
+                return state == N_FAINT ? N_FAINT : goalState;
+            }
+            return N_DEATH;
+        }
+
+        if (nextState == state)
+            nextState = N_NONE;
+
+        bool canShot = tinfo.target && tinfo.target->health > 0 && canSee(DIST_SHOT);
+
+        if (health > HALF_HEALTH)                       // stage 1
+        {
+            bool flying = (state == N_FLY) && !(canShot && rand_logic() < 256);
+            fly(state == N_FLY);
+            extraE->maxTurn = ANGLE(3);
+
+            switch (state)
+            {
+                case N_STOP:
+                    return canShot ? N_AIM : N_FLY;
+
+                case N_FLY:
+                {
+                    if (canShot && rand_logic() < 0x0400)      // about one bolt a second
+                        shoot(100, DIST_SHOT);
+                    if (!flying && pos.y >= roomFloor - 128)
+                        return N_STOP;
+                    break;
+                }
+
+                case N_AIM:
+                {
+                    if (nextState)
+                        return nextState;
+                    return canShot ? N_FIRE : N_STOP;
+                }
+
+                case N_FIRE:
+                {
+                    if (!nextState) {
+                        shoot(100, DIST_SHOT);
+                        shoot(100, DIST_SHOT);
+                        shoot(100, DIST_SHOT);
+                        nextState = N_STOP;
+                    }
+                    break;
+                }
+            }
+            return goalState;
+        }
+
+        // stage 2
+        fly(false);
+        switch (state)
+        {
+            case N_RUN:
+            case N_STAND:
+            {
+                extraE->maxTurn = (state == N_RUN) ? ANGLE(6) : ANGLE(3);
+                if (state == N_RUN)
+                    tinfo.tilt = tinfo.turn;
+                if (canShot && rand_logic() < 0x0600)      // about every 2/3 s
+                    shoot(50, DIST_SHOT);
+                return (canShot && abs(tinfo.angle) < ANGLE(30)) ? N_STAND : N_RUN;
+            }
+
+            case N_FLY:
+                health = FAINT_HEALTH;
+                return N_FALL;
+
+            case N_STOP:
+            case N_AIM:
+            case N_FIRE:
+                health = FAINT_HEALTH;
+                return N_FAINT;
+        }
+        return goalState;
+    }
+};
+
+
+struct Adam : Enemy
+{
+    // ENEMIES-2: the giant mutant ("Torso", Great Pyramid).  Ported from the full engine.
+    enum {
+        HIT_MASK_HAND  = 0x3FF8000,
+        HIT_MASK_HANDS = 0x3FFFFF0,
+        DAMAGE         = 500,
+        DAMAGE_WALK    = 5,
+        DAMAGE_FATAL   = 1000,
+        DIST_ATTACK    = 2600,
+        DIST_FATAL     = 2250,
+        ANIM_DEATH     = 13
+    };
+
+    enum {
+        STATE_NONE,
+        STATE_STOP,
+        STATE_TURN_LEFT,
+        STATE_TURN_RIGHT,
+        STATE_ATTACK_1,
+        STATE_ATTACK_2,
+        STATE_ATTACK_3,
+        STATE_WALK,
+        STATE_BORN,
+        STATE_FALL,
+        STATE_UNUSED,
+        STATE_FATAL
+    };
+
+    Adam(Room* room) : Enemy(room, 500, 341, 0, AGGRESSION_LVL_MAX) {}
+
+    virtual void hit(int32 damage, const vec3i &point, int32 soundId)
+    {
+        Enemy::hit(damage, point, SND_HIT_ADAM);
+        if (health <= 0)
+            animSet(level.models[type].animIndex + ANIM_DEATH, true);
+    }
+
+    virtual int32 updateState()
+    {
+        if (health <= 0)
+            return goalState;
+
+        if (state == STATE_BORN)
+            return STATE_FALL;
+
+        if (state == STATE_FALL)
+        {
+            if (pos.y < roomFloor) {
+                flags |= ITEM_FLAG_GRAVITY;
+                return STATE_FALL;
+            }
+            flags &= ~ITEM_FLAG_GRAVITY;
+            pos.y = roomFloor;
+            return STATE_STOP;
+        }
+
+        if (!tinfo.target || tinfo.target->health <= 0)
+            return STATE_STOP;
+
+        if (hitMask)
+            tinfo.target->hit(DAMAGE_WALK, tinfo.target->pos, 0);
+
+        if (state == STATE_STOP || state == STATE_WALK || state == STATE_TURN_LEFT || state == STATE_TURN_RIGHT)
+            extraE->maxTurn = (abs(tinfo.angle) > ANGLE(10)) ? ANGLE(3) : 0;
+
+        switch (state)
+        {
+            case STATE_STOP:
+            {
+                nextState = STATE_NONE;
+                if (tinfo.angle > ANGLE(45))
+                    return STATE_TURN_RIGHT;
+                if (tinfo.angle < -ANGLE(45))
+                    return STATE_TURN_LEFT;
+                if (tinfo.dist < DIST_ATTACK) {
+                    if (tinfo.target->health <= DAMAGE) {
+                        if (tinfo.dist < DIST_FATAL)
+                            return STATE_ATTACK_3;
+                    } else {
+                        return (rand_logic() & 1) ? STATE_ATTACK_1 : STATE_ATTACK_2;
+                    }
+                }
+                return STATE_WALK;
+            }
+
+            case STATE_WALK:
+            {
+                if (tinfo.dist < DIST_ATTACK || tinfo.angle > ANGLE(45) || tinfo.angle < -ANGLE(45))
+                    return STATE_STOP;
+                break;
+            }
+
+            case STATE_TURN_RIGHT:
+            {
+                if (tinfo.angle < ANGLE(45))
+                    return STATE_STOP;
+                break;
+            }
+
+            case STATE_TURN_LEFT:
+            {
+                if (tinfo.angle > -ANGLE(45))
+                    return STATE_STOP;
+                break;
+            }
+
+            case STATE_ATTACK_1:
+            case STATE_ATTACK_2:
+            {
+                if (!nextState && (((state == STATE_ATTACK_1) && (hitMask & HIT_MASK_HAND)) ||
+                                   ((state == STATE_ATTACK_2) && (hitMask & HIT_MASK_HANDS)))) {
+                    tinfo.target->hit(DAMAGE, tinfo.target->pos, 0);
+                    nextState = STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_ATTACK_3:
+            {
+                if (hitMask & HIT_MASK_HAND) {
+                    tinfo.target->hit(DAMAGE_FATAL, tinfo.target->pos, 0);
+                    return STATE_FATAL;
+                }
+                break;
+            }
+        }
+
+        return goalState;
     }
 };
 
