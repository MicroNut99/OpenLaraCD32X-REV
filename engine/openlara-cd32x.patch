+                    nextState = STATE_WAIT;
+                else if (canSee(DIST_SHOT))
+                    nextState = STATE_AIM;
+                else if (tinfo.front && tinfo.dist < DIST_WALK)
+                    nextState = STATE_WALK;
+                else
+                    break;
+                return STATE_STOP;
+            }
+
+            case STATE_AIM:
