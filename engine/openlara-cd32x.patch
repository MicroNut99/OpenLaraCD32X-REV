+    sndCmd(SND_CMD_PLAY);
+    sndTrack = track;
+    sndGrace = 180;                 /* ~3 s: the drive seeks before it reports "playing" */
+}
+
+void sndForgetTrack()               /* FMV-1: a movie stopped the music - the engine restarts it */
+{
+    sndTrack = 0;
+    sndGrace = 0;
+}
+
+void sndStopTrack()
+{
+    /* OL-12: music triggers that say "stop" are ignored - the level music keeps playing.
+       (A level load stops the music itself, before it reads the disc.) */
+}
+
+bool sndTrackIsPlaying()
+{
+    if (!sndTrack)
+        return false;
+    if (sndLoops(sndTrack))         /* looping music plays until it is stopped */
+        return true;
+    if (sndGrace > 0) {
+        sndGrace--;
+        return true;
+    }
+    int32 st = (SND_COMM14 >> 12) & 0x0F;   /* drive: 1 playing, 2 seeking, 3 scanning */
+    if (st == 1 || st == 2 || st == 3)
+        return true;
+    sndTrack = 0;                   /* the cue has ended - the engine restarts the level music */
+    return false;
+}
+
+void sndStopSample(int32 index) {}
+void sndStop() { sndCutLevel = -1; }   /* OL-8: effects only - the CD music keeps playing;
+                                           CUTAUDIO-1: a level starts - its sound may play */
