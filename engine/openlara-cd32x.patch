 struct Doppelganger : Enemy
 {
     Doppelganger(Room* room) : Enemy(room, LARA_MAX_HEALTH, 10, 0, 0) {}
+
+#ifdef CD32X
+    /* -------------------------------------------------------------------------------------
+     * DOPPEL-1: Lara's double in Atlantis.  The fixed-point engine never implemented her
+     * (empty class: she stood still).  Ported from OpenLara's full engine (src/enemy.h,
+     * struct Doppelganger), which follows the original game:
+     *  - she mirrors Lara through the room centre (36, 60 sectors): same height, opposite
+     *    x/z, facing the other way, and plays exactly Lara's animation frame;
+     *  - shooting her hurts Lara (10 x the damage) and never her;
+     *  - when her mirrored spot is over the pit (floor > 1024 below) while Lara stands on
+     *    solid ground, she falls (Lara's fall animation), lands, fires the trigger under her
+     *    (opens the way on) and disappears.
+     * She needs no AI slot (no navigation), so activate() does not ask for one.
+     * ------------------------------------------------------------------------------------- */
+    enum {
+        CENTER_X  = 36 * 1024,
+        CENTER_Z  = 60 * 1024,
+        ANIM_FALL = 34              // Lara's model: falling forward
+    };
+
+    virtual void activate()
+    {
+        ItemObj::activate();
+        flags &= ~ITEM_FLAG_STATUS;
+        flags |= ITEM_FLAG_STATUS_ACTIVE;
+    }
+
+    virtual void hit(int32 damage, const vec3i &point, int32 soundId)
+    {
+        Lara* lara = getLara(pos);
+        if (lara) {
+            lara->hit(damage * 10, lara->pos, 0);
+        }
+    }
+
+    virtual void collide(Lara* lara, CollisionInfo* cinfo) {}
+
+    virtual void update()
+    {
+        Lara* lara = getLara(pos);
+        if (!lara)
+            return;
+
+        if (!(flags & ITEM_FLAG_GRAVITY))
+        {
+            pos.x = CENTER_X * 2 - lara->pos.x;     // mirror through the room centre
+            pos.y = lara->pos.y;
+            pos.z = CENTER_Z * 2 - lara->pos.z;
+            angle.x = lara->angle.x;
+            angle.z = lara->angle.z;
+            angle.y = lara->angle.y + ANGLE_180;
+            animIndex  = lara->animIndex;           // Lara's frame, drawn with her own meshes
+            frameIndex = lara->frameIndex;
+            state = goalState = lara->state;
+
+            int32 laraFloor = lara->room->getSector(lara->pos.x, lara->pos.z)->getFloor(lara->pos.x, lara->pos.y, lara->pos.z);
+
+            updateRoom();                           // room + roomFloor at the mirrored spot
+
+            if (!(lara->flags & ITEM_FLAG_GRAVITY) && (roomFloor - pos.y > 1024) && (laraFloor - lara->pos.y < 256))
+            {
+                animSet(level.models[ITEM_LARA].animIndex + ANIM_FALL, true);
+                flags |= ITEM_FLAG_GRAVITY;
+                vSpeed = 0;
+                hSpeed = 0;
+            }
+        }
+        else
+        {
+            animProcess();                          // falls (gravity in move())
+            updateRoom();
+
+            if (pos.y >= roomFloor)
+            {
+                pos.y = roomFloor;
+                checkTrigger(gLastFloorData, NULL); // the trigger under her (set by updateRoom)
+                flags &= ~(ITEM_FLAG_GRAVITY | ITEM_FLAG_STATUS);
+                flags |= ITEM_FLAG_STATUS_INVISIBLE;
+                deactivate();
+            }
+        }
+    }
+#endif
 };
 
 
