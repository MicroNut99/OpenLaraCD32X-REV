diff --git a/src/platform/32x/fmv.inc b/src/platform/32x/fmv.inc
new file mode 100644
index 0000000..390bc66
--- /dev/null
+++ b/src/platform/32x/fmv.inc
@@ -0,0 +1,411 @@
+/* ---------------------------------------------------------------------------------------
+ * FMV-1: the original game's movies (RoQ video + DPCM sound), played from the passport.
+ *   Included by main.cpp (CD32X build only).  The movies were converted from the PC game's
+ *   .RPL files with ffmpeg (tools: see README): 288 x 112, 15 frames/s, 22050 Hz mono.
+ *
+ *   1. The .ROQ file is loaded from the CD into the cart's level slot (2 MB), exactly like a
+ *      level (CMD 38 file 300 + movie, CMD 46 chunks, splash + red bar).  Only files up to
+ *      0x1F0000 bytes fit before the save area - bigger ones are refused (FMV-2: streaming).
+ *      The level slot then holds the movie, so the next level load reads its level again.
+ *   2. The MASTER decodes the pictures straight from the cart with the RoQ decoder of
+ *      Victor Luchits' Doom 32X: Resurrection (roq_read.c, MIT; decoder by Tim Ferguson).
+ *      It draws in the 32X's 32768-colour mode, straight into the frame buffer; the previous
+ *      picture is kept in SDRAM (canvascopy, 68 KB) - borrowed from the 3D renderer's
+ *      vertex and face lists (renderScratch, render.cpp - FMV-1b), which are not used
+ *      while a movie plays.  Every line is shown twice (288 x 224 on screen).
+ *   3. The SLAVE plays the sound: it walks the same file in the cart, decodes the sound
+ *      chunks (DPCM) into 316-sample blocks and feeds them to the 32X PWM with its DMA
+ *      channel 1, paced by the PWM's own requests (DREQ).  The slave runs with interrupts
+ *      masked, so it polls the end of each block (TE) instead of a DMA interrupt.
+ *      The PWM is turned on (ramped to the middle) while the movie loads - no click.
+ *   4. A, B, C or START (after the first few frames) stops the movie.  Afterwards: 256-colour
+ *      mode, the game's line tables, palette and music come back.
+ * --------------------------------------------------------------------------------------- */
+#include "roq.h"
+
+#define FMV_FILE_BASE       300                 /* subcpu/main.c: 300 + movie -> slot 16 */
+#define FMV_MAX_LEN         0x1F0000            /* the level slot, up to the save area   */
+#define MARS_CMD_FMV_AUDIO  0x7A5C              /* slave command: play the movie's sound */
+#define MARS_CMD_FMV_PWM    0x7A5D              /* slave command: PWM on, slowly to the middle */
+#define FMV_CENTER          (2 + (32768 >> 6))  /* PWM value of silence */
+#define FMV_VOLUME          7                   /* FMV-1d: 16 = full, 8 = half (-6 dB); 7 tested on hardware */
+#define FMV_PWM(v)          (FMV_CENTER + ((((v) - 32768) * FMV_VOLUME) >> 10))   /* 0..65535 -> PWM */
+#define FMV_SAMPLES         316                 /* one PWM block (about 70 per second)   */
+#define FMV_SHARED(v)       (*(volatile int32 *)((uint32)&(v) | 0x20000000))   /* cache-through */
+
+void sndForgetTrack();                          /* FMV-1: sound.cpp - restart the music     */
+void* renderScratch(int32* size);               /* FMV-1: render.cpp - the borrowed lists   */
+void renderScratchDone();                       /*        ... given back (ordering table 0) */
+
+static int32 gFmvLen = 0;                       /* the movie's length, for the slave        */
+static int32 gFmvStop = 0;                      /* master -> slave: stop the sound          */
+static uint16 gFmvSnd[2][FMV_SAMPLES] __attribute__((aligned(16)));
+
+/* ----------------------------------------------------------------------------- the slave */
+struct FmvAudio
+{
+    const uint8* p;                             /* next chunk header in the cart */
+    const uint8* end;
+    int32 rem;                                  /* samples left in the current sound chunk */
+    int32 val;                                  /* DPCM predictor 0..65535 */
+};
+
+static void fmvAudioFill(FmvAudio &a, uint16* dst)  /* one block of PWM samples */
+{
+    int32 i = 0;
+    while (i < FMV_SAMPLES)
+    {
+        if (a.rem <= 0)                         /* the next sound chunk */
+        {
+            while (a.p + 8 <= a.end)
+            {
+                const uint8* h = a.p;
+                uint32 id = h[0] | (h[1] << 8);
+                uint32 size = h[2] | (h[3] << 8) | (h[4] << 16) | ((uint32)h[5] << 24);
+                if (size > (uint32)(a.end - h - 8))
+                {
+                    a.p = a.end;                /* broken chunk: the end */
+                    break;
+                }
+                a.p = h + 8;
+                if (id == RoQ_SOUND_MONO)
+                {
+                    a.val = (int32)(int16)(h[6] | (h[7] << 8)) + 32768;
+                    a.rem = (int32)size;
+                    break;
+                }
+                a.p += size;                    /* a picture chunk: not ours */
+            }
+            if (a.rem <= 0)                     /* no sound left: hold the last value */
+            {
+                uint16 last = (uint16)FMV_PWM(a.val);
+                for (; i < FMV_SAMPLES; i++)
+                    dst[i] = last;
+                return;
+            }
+        }
+
+        int32 n = a.rem;
+        if (n > FMV_SAMPLES - i)
+            n = FMV_SAMPLES - i;
+        const uint8* b = a.p;
+        int32 v = a.val;
+        for (int32 j = 0; j < n; j++)
+        {
+            int32 c = b[j];
+            int32 d = (c & 127) * (c & 127);    /* the RoQ DPCM step: the square, signed */
+            v += (c & 128) ? -d : d;
+            if (v > 65535) v = 65535;
+            else if (v < 0) v = 0;
+            dst[i + j] = (uint16)FMV_PWM(v);
+        }
+        a.val = v;
+        a.p = b + n;
+        a.rem -= n;
+        i += n;
+    }
+}
+
+static void fmvAudioStart(uint16* buf)          /* slave DMA 1 -> PWM mono, on PWM requests */
+{
+    SH2_DMA_CHCR1 = 0;
+    SH2_DMA_SAR1 = (uint32)buf;
+    SH2_DMA_DAR1 = (uint32)&MARS_PWM_MONO;
+    SH2_DMA_TCR1 = FMV_SAMPLES;
+    SH2_DMA_CHCR1 = 0x14e1;                     /* dest fixed, src +, word, DREQ, no interrupt */
+}
+
+static void fmvPwmRamp(int32 from, int32 to, int32 each)   /* slave: no click on a real 32X */
+{
+    int32 step = (from < to) ? 1 : -1;
+    for (int32 v = from; v != to; v += step)
+        for (int32 i = 0; i < each; i++)
+        {
+            while (MARS_PWM_MONO & 0x8000) {}   /* FIFO full: wait */
+            MARS_PWM_MONO = (uint16)v;
+        }
+}
+
+static void fmvPwmOn()                          /* slave: MARS_CMD_FMV_PWM, while the movie loads */
+{
+    if (MARS_VDP_DISPMODE & MARS_NTSC_FORMAT)
+        MARS_PWM_CYCLE = (((23011361 << 1) / RoQ_SAMPLE_RATE + 1) >> 1) + 1;
+    else
+        MARS_PWM_CYCLE = (((22801467 << 1) / RoQ_SAMPLE_RATE + 1) >> 1) + 1;
+    MARS_PWM_CTRL = 0x0185;                     /* L/R on, DREQ every PWM cycle (Vic's values) */
+    fmvPwmRamp(1, FMV_CENTER, 86);              /* about 2 s, like Vic's Mars_InitPWM */
+}
+
+static void fmvAudio()                          /* slave: MARS_CMD_FMV_AUDIO */
+{
+    CacheClear();                               /* the movie is new in the cart */
+
+    FmvAudio a;
+    a.p = (const uint8*)CD_LEVEL_CART + 8;      /* after the file header */
+    a.end = (const uint8*)CD_LEVEL_CART + FMV_SHARED(gFmvLen);
+    a.rem = 0;
+    a.val = 32768;
+
+    uint16* buf[2];
+    buf[0] = (uint16*)((uint32)gFmvSnd[0] | 0x20000000);   /* written cache-through */
+    buf[1] = (uint16*)((uint32)gFmvSnd[1] | 0x20000000);
+
+    fmvAudioFill(a, buf[0]);
+    fmvAudioFill(a, buf[1]);
+    fmvAudioStart(buf[0]);
+    int32 next = 1;
+
+    while (!FMV_SHARED(gFmvStop))
+    {
+        if (!(SH2_DMA_CHCR1 & 2))               /* TE: block not finished yet */
+        {
+            for (volatile int32 k = 0; k < 32; k++) {}   /* don't hammer the shared flag */
+            continue;
+        }
+        SH2_DMA_CHCR1;                          /* TE read, then cleared by the next start */
+        fmvAudioStart(buf[next]);
+        next ^= 1;
+        fmvAudioFill(a, buf[next]);
+    }
+
+    SH2_DMA_CHCR1 = 0;                          /* stop, then slowly down to 0 (no click) */
+    int32 last = FMV_PWM(a.val);
+    if (last > FMV_CENTER * 2) last = FMV_CENTER * 2;
+    fmvPwmRamp(last, 1, 4);
+}
+
+/* ---------------------------------------------------------------------------- the master */
+static const uint8* gFmvPos;                    /* the next chunk in the cart */
+static const uint8* gFmvEnd;
+
+static void fmvGetChunk(roq_file* fp)           /* the decoder's next picture chunk */
+{
+    if (fp->bof)                                /* the 8-byte file header */
+    {
+        fp->data = (unsigned char*)gFmvPos;
+        fp->page_base = fp->data;
+        fp->page_end = fp->data + 8;
+        return;
+    }
+    while (gFmvPos + 8 <= gFmvEnd)
+    {
+        const uint8* h = gFmvPos;
+        uint32 id = h[0] | (h[1] << 8);
+        uint32 size = h[2] | (h[3] << 8) | (h[4] << 16) | ((uint32)h[5] << 24);
+        if (size > (uint32)(gFmvEnd - h - 8))
+            break;
+        if (id == RoQ_SOUND_MONO || id == RoQ_SOUND_STEREO)
+        {
+            gFmvPos = h + 8 + size;             /* the slave plays these */
+            continue;
+        }
+        fp->data = (unsigned char*)h;
+        fp->page_base = fp->data;
+        fp->page_end = fp->data + 8 + size;
+        return;
+    }
+    fp->eof = 1;                                /* the end of the movie */
+    fp->data = NULL;
+}
+
+static void fmvRetChunk(roq_file* fp)
+{
+    if (!fp->data)
+        return;
+    gFmvPos = fp->page_end;
+    fp->bof = 0;
+}
+
+static void fmvFinish()                         /* the decoder may draw: last picture shown */
+{
+    pageWait();
+}
+
+static void fmvWaitVBlank()
+{
+    while (MARS_VDP_FBCTL & MARS_VDP_VBLK) {}
+    while (!(MARS_VDP_FBCTL & MARS_VDP_VBLK)) {}
+}
+
+static void fmvLines(int32 pitch, int32 height) /* both pages: line tables + black */
+{
+    for (int32 page = 0; page < 2; page++)
+    {
+        volatile uint16* lines = &MARS_FRAMEBUFFER;
+        fast_memset((void*)((uint8*)&MARS_FRAMEBUFFER + 0x200), 0, (0x20000 - 0x200) >> 2);
+        for (int32 j = 0; j < 256; j++)
+        {
+            if (pitch && j < height * 2)
+                lines[j] = (uint16)((j >> 1) * pitch + 0x100);  /* every line twice */
+            else if (pitch)
+                lines[j] = (uint16)(height * pitch + 0x100);    /* a black line */
+            else
+                lines[j] = (uint16)(0x100 + ((j < FRAME_HEIGHT - 1) ? j : FRAME_HEIGHT - 1) * (FRAME_WIDTH / 2));
+        }
+        pageFlip();
+        pageWait();
+    }
+}
+
+static int32 fmvPad()
+{
+    MARS_SYS_COMM2 = 0;                         /* no sound effect */
+    cdCmd(CD_CMD_GET_PAD);
+    return MARS_SYS_COMM8;
+}
+
+static void fmvFail(uint16 colour)              /* FMV-1c: why a movie didn't play - 1 s flash */
+{
+    for (int32 i = 0; i < 256; i++)
+    {
+        while ((MARS_VDP_FBCTL & MARS_VDP_PEN) == 0) {}
+        (&MARS_CRAM)[i] = colour;
+    }
+    int32 t = *(volatile int32*)&gFrameIndex;
+    while (*(volatile int32*)&gFrameIndex - t < 60) {}
+    if (gGamePalette)
+        osSetPalette(gGamePalette);
+}
+#define FMV_RED     0x001F                      /* no memory */
+#define FMV_YELLOW  0x03FF                      /* not on the disc / too big */
+#define FMV_BLUE    0x7C00                      /* loading failed */
+#define FMV_MAGENTA 0x7C1F                      /* not a RoQ movie */
+
+/* plays movie n (0 CORE, 1 MANSION, 2 CAFE, 3 SNOW, 4 LIFT, 5 VISION, 6 CANYON, 7 PYRAMID,
+   8 PRISON, 9 ESCAPE, 10 END); false = not played (not on the disc / too big / no memory) */
+bool osPlayVideo(int32 n)
+{
+#ifdef CD32X_OVERLAP
+    renderFinish();                             /* the slave's last frame */
+#endif
+    MARS_WAIT();
+    pageWait();
+
+    /* memory first: nothing is loaded if the lists can't be borrowed */
+    int32 scratchSize = 0;
+    uint8* scratch = (uint8*)renderScratch(&scratchSize);
+    const int32 copyOfs = 3328;                 /* FMV-1b: ri 256 + codebooks 3072, then the copy */
+    if (!scratch || scratchSize < copyOfs + 304 * 112 * 2)
+    {
+        fmvFail(FMV_RED);
+        return false;
+    }
+
+    MARS_SYS_COMM2 = (uint16)(FMV_FILE_BASE + n);   /* the length, before anything moves */
+    cdCmd(CD_CMD_OPEN_FILE);
+    int32 len = (MARS_SYS_COMM0 == 0) ? (int32)CD_COMM8_32 : 0;
+    if (len <= 8 || len > FMV_MAX_LEN)
+    {
+        renderScratchDone();
+        fmvFail(FMV_YELLOW);
+        return false;
+    }
+
+    MARS_SYS_COMM2 = 0;                         /* music off - no CD data reads while it plays */
+    cdCmd(54);
+    sndForgetTrack();                           /* the engine restarts it afterwards */
+
+    splashBegin();
+    MARS_SYS_COMM4 = MARS_CMD_FMV_PWM;          /* the slave turns the PWM on meanwhile */
+    gCartLevel = -1;                            /* the level slot is the movie's now */
+    int32 res = cdLoadToCart((uint16)(FMV_FILE_BASE + n));
+    CacheClear();
+    MARS_WAIT();                                /* PWM ramp done */
+    MARS_SYS_COMM4 = MARS_CMD_CACHE;            /* slave: forget the old cart data too */
+    MARS_WAIT();
+    if (res <= 8)
+    {
+        splashEnd();
+        renderScratchDone();
+        fmvFail(FMV_BLUE);
+        return false;
+    }
+
+    /* the decoder's memory, in the borrowed lists */
+    memset(scratch, 0, copyOfs);
+    roq_info* ri = (roq_info*)scratch;
+    ri->cells_u = (roq_cell*)(scratch + 256);   /* 256 x 8 */
+    ri->qcells_u = (roq_qcell*)(scratch + 256 + 2048);   /* 256 x 4 */
+    ri->canvascopy = (short*)(scratch + copyOfs);
+
+    roq_file fp;
+    memset(&fp, 0, sizeof(fp));
+    fp.bof = 1;
+    gFmvPos = (const uint8*)CD_LEVEL_CART;
+    gFmvEnd = gFmvPos + res;
+
+    int32 displayRate = (MARS_VDP_DISPMODE & MARS_NTSC_FORMAT) ? 60 : 50;
+    roq_init(ri, &fp, fmvGetChunk, fmvRetChunk, displayRate, (short*)((uint8*)&MARS_FRAMEBUFFER + 0x200));
+
+    bool ok = (roq_read_info(&fp, ri) == 0) && ri->framerate > 0 && ri->width <= 304 &&
+              ri->canvas_pitch * ri->display_height * 2 <= scratchSize - copyOfs &&
+              ri->display_height * 2 <= FRAME_HEIGHT;
+    if (!ok)
+    {
+        splashEnd();
+        renderScratchDone();
+        fmvFail(FMV_MAGENTA);
+        return false;
+    }
+
+    /* 32768 colours, every line twice */
+    fmvWaitVBlank();
+    MARS_VDP_DISPMODE = MARS_224_LINES | MARS_VDP_MODE_OFF;
+    fmvLines(ri->canvas_pitch, ri->display_height);
+    fmvWaitVBlank();
+    MARS_VDP_DISPMODE = MARS_224_LINES | MARS_VDP_MODE_32K;
+
+    SH2_DMA_CHCR1 = 0;                          /* master DMA 1: the picture copy (decoder) */
+    SH2_DMA_DRCR1 = 0;
+    SH2_DMA_DMAOR = 1;
+
+    FMV_SHARED(gFmvLen) = res;
+    FMV_SHARED(gFmvStop) = 0;
+    bool audio = false;
+
+    int32 start = gFrameIndex;
+    int32 frames = 0;
+    int32 prev = 0xFFFF;                        /* buttons held when the movie starts don't count */
+    while (1)
+    {
+        int32 pad = fmvPad();
+        int32 hit = pad & ~prev;
+        prev = pad;
+        if (frames > 5 && (hit & (SEGA_CTRL_A | SEGA_CTRL_B | SEGA_CTRL_C | SEGA_CTRL_START)))
+            break;
+
+        CacheClear();                           /* the copy was written by DMA */
+        if (roq_read_frame(ri, 0, fmvFinish) <= 0)
+            break;
+        pageFlip();                             /* shown at the next vertical blank */
+
+        if (!audio)                             /* the sound starts with the first picture */
+        {
+            MARS_SYS_COMM4 = MARS_CMD_FMV_AUDIO;
+            audio = true;
+            start = *(volatile int32*)&gFrameIndex;
+        }
+
+        frames++;
+        int32 due = start + (frames * displayRate) / (int32)ri->framerate;
+        while (*(volatile int32*)&gFrameIndex - due < 0) {}
+    }
+
+    /* the end: sound off, the game's screen back */
+    FMV_SHARED(gFmvStop) = 1;
+    MARS_WAIT();
+    pageWait();
+    SH2_DMA_CHCR1 = 0;
+
+    fmvWaitVBlank();
+    MARS_VDP_DISPMODE = MARS_224_LINES | MARS_VDP_MODE_OFF;
+    fmvLines(0, 0);                             /* the game's line tables, black */
+    if (gGamePalette)
+        osSetPalette(gGamePalette);
+    fmvWaitVBlank();
+    MARS_VDP_DISPMODE = MARS_224_LINES | MARS_VDP_MODE_256;
+
+    renderScratchDone();
+    CacheClear();
+    return true;
+}
diff --git a/src/platform/32x/main.cpp b/src/platform/32x/main.cpp
index 42f1f7e..b1d44af 100644
--- a/src/platform/32x/main.cpp
+++ b/src/platform/32x/main.cpp
@@ -1,10 +1,212 @@
 const void* TRACKS_IMA;
 const void* TITLE_SCR;
 
+#ifndef CD32X
 extern void* LEVEL1_PKD;
+extern void* LEVEL2_PKD;
+#endif
 
 #include "game.h"
 
+#ifdef CD32X
+/* ---------------------------------------------------------------------------------------
+ * CD32X build (Sega CD + 32X + 4 MB RAM cart).
+ * The Genesis side does NOT run OpenLara's own 68000 code (src-md).  The 68000 stays in the
