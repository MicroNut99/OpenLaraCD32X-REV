+
+        ANIM_DEATH_1 = 9,
+        ANIM_DEATH_2 = 10
+    };
+
+    enum {
+        STATE_NONE = 0,
+        STATE_DEATH = 0,
+        STATE_STOP,
+        STATE_WALK,
+        STATE_RUN,
+        STATE_ATTACK_1,
