+        DAMAGE_KICK = 200,
+        ANIM_DEATH  = 8
+    };
+
+    enum {
+        STATE_NONE,
+        STATE_STOP,
+        STATE_FIRE,
+        STATE_RUN,
+        STATE_AIM,
+        STATE_DEATH,
