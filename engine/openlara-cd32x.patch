+struct Skater : Human
+{
+    enum {
+        SK_STOP,
+        SK_STAND_FIRE,
+        SK_MOVE,
+        SK_STEP,
+        SK_MOVE_FIRE,
+        SK_DEATH
+    };
+
+    Skater(Room* room) : Human(room, 125, 204) {}
+
+    virtual int32 deathAnim() { return 13; }
+
+    virtual void hit(int32 damage, const vec3i &point, int32 soundId)
+    {
+        Human::hit(damage, point, SND_HIT_SKATER);
+    }
+
+    virtual int32 updateState()
+    {
+        if (health <= 0)
+            return goalState;
+
+        switch (state)
+        {
+            case SK_STOP:
+            {
+                nextState = 0;
+                return canSee(DIST_SHOT) ? SK_STAND_FIRE : SK_MOVE;
+            }
+
+            case SK_MOVE:
+            {
+                nextState = 0;
+                extraE->maxTurn = ANGLE(4);
+                tinfo.tilt = tinfo.turn;
+                if (rand_logic() < 512)
+                    return SK_STEP;
+                if (canSee(DIST_SHOT))
+                    return (mood != MOOD_ESCAPE && tinfo.dist > 2560 && tinfo.dist < 4096) ? SK_STOP : SK_MOVE_FIRE;
+                break;
+            }
+
+            case SK_STEP:
+            {
+                extraE->maxTurn = ANGLE(4);
+                if (rand_logic() < 1024)
+                    return SK_MOVE;
+                break;
+            }
+
+            case SK_STAND_FIRE:
+            case SK_MOVE_FIRE:
+            {
+                if (state == SK_MOVE_FIRE)
+                    extraE->maxTurn = ANGLE(4);
+                if (!nextState && canSee(DIST_SHOT)) {
+                    int32 damage = (state == SK_STAND_FIRE) ? 50 : 40;
+                    shoot(damage, DIST_SHOT);
+                    shoot(damage, DIST_SHOT);
+                    nextState = 1;
+                }
+                if (mood == MOOD_ESCAPE || tinfo.dist < 1024)
+                    return SK_MOVE;
+                break;
+            }
+        }
+
+        return goalState;
+    }
+};
