diff --git a/src/platform/32x/32x.h b/src/platform/32x/32x.h
index c06d4b3..2aa108a 100644
--- a/src/platform/32x/32x.h
+++ b/src/platform/32x/32x.h
@@ -155,6 +155,65 @@ extern "C"
     CacheControl(0);\
     CacheControl(SH2_CCTL_CP | SH2_CCTL_CE);
 
+/* =========================================================================================
+ * CD32X REV-1..4 - speed-ups after v1.3 (each one can be switched off on its own):
+ *   REV-1  CD32X_IDLE     wait loops pause between reads of a COMM / VDP register.  Both SH2s
+ *                         share ONE bus: a tight loop reading a register takes the bus over and
+ *                         over, so the OTHER SH2 (drawing, game logic) waits for it.  The pause
+ *                         runs from the SH2's cache (nop, counter in a register): no bus use.
+ *                         (Kobo hardware rule: never hammer a register, pause between polls.)
+ *                         Off: -DCD32X_NO_IDLE
+ *   REV-2  CD32X_FILL     the screen clear uses the 32X VDP's auto fill (main.cpp pageClear):
+ *                         the VDP writes the zeros itself, the SH2 bus stays free.
+ *                         Off: -DCD32X_NO_FILL
+ *   REV-3  CD32X_SDCODE   the C drawing code that runs per polygon (flush_ot, drawPolyY, the
+ *                         sprite / line / fill rasterizers) lives in SDRAM, like the asm
+ *                         rasterizers already do - a cache miss there costs less than in the cart.
+ *                         Off: -DCD32X_NO_SDCODE
+ *   REV-4  CD32X_HWDIV    the SH2's own divider for the split-line clipping (drawPolyY).
+ *                         Off: -DCD32X_NO_HWDIV
+ * Example: make CD32X=1 EXTRA="-DCD32X_NO_FILL"   (Makefile: EXTRA is added to the C flags)
+ * ========================================================================================= */
+#if defined(CD32X) && !defined(CD32X_NO_IDLE)
+    #define CD32X_IDLE
+#endif
+#if defined(CD32X) && !defined(CD32X_NO_FILL)
+    #define CD32X_FILL
+#endif
+#if defined(CD32X) && !defined(CD32X_NO_SDCODE)
+    #define CD32X_SDCODE
+#endif
+#if defined(CD32X) && !defined(CD32X_NO_HWDIV)
+    #define CD32X_HWDIV
+#endif
+
+#ifdef CD32X_IDLE
+/* REV-1: about 160 cycles (7 us) without touching the bus - the loop stays in the cache */
+static inline void marsIdle()
+{
+    for (int k = 0; k < 32; k++)
+        __asm__ volatile ("nop");
+}
+#define MARS_WAIT() {while (MARS_SYS_COMM4) marsIdle();}
+#else
+static inline void marsIdle()
+{
+    for (volatile int k = 0; k < 16; k++) {}    /* v1.3's pause */
+}
 #define MARS_WAIT() {while (MARS_SYS_COMM4);}
+#endif
+
+#ifdef CD32X_SDCODE
+/* REV-3: code placed in SDRAM (.data.* is copied to SDRAM at start, see mars.ld / output.map) */
+#define SDRAM_CODE  __attribute__((section(".data.sdcode"), aligned(16)))
+#else
+#define SDRAM_CODE
+#endif
+
+/* REV-4: SH2 on-chip divider (32 / 32 signed).  Write the divisor, write the dividend (starts the
+   division, 39 cycles), read the quotient (the read waits until it is ready).  Same use as D32XR
+   (r_main.c, r_phase2.c).  Not used in interrupt handlers - only drawPolyY. */
+#define SH2_DIVU_DVSR       (*(volatile long *)0xFFFFFF00)
+#define SH2_DIVU_DVDNT      (*(volatile long *)0xFFFFFF04)
 
 #endif
