+                if (nextState)
+                    return nextState;
+                return canSee(8192) ? STATE_FIRE : STATE_STOP;
+            }
+
+            case STATE_FIRE:
+            {
+                if (!nextState) {
+                    nextState = STATE_AIM;
+                    shoot(DAMAGE_SHOT, 8192);
+                }
+                break;
+            }
+
+            case STATE_IDLE:
+            {
+                if (!nextState && (hitMask & HIT_MASK)) {
+                    bite(DAMAGE_KICK, _vec3i(50, 30, 0), 5);
+                    nextState = STATE_STOP;
+                }
+                break;
+            }
+        }
+
+        return goalState;
+    }
