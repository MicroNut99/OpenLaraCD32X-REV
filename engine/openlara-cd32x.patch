+                if (nextState)
+                    return nextState;
+                return canSee(DIST_SHOT) ? STATE_FIRE : STATE_STOP;
+            }
+
+            case STATE_FIRE:
+            {
+                if (!nextState) {
+                    for (int32 i = 0; i < shots; i++)
+                        shoot(damage, DIST_SHOT);
+                    nextState = STATE_AIM;
+                }
+                if (mood == MOOD_ESCAPE || !tinfo.target || tinfo.target->health <= 0)
+                    nextState = STATE_STOP;
+                break;
+            }
+        }
+
+        return goalState;
+    }
+
+    // stop / walk / run / aim / fire-in-WAIT, as the cowboy and Mr. T do it
+    int32 updateGunner(int32 damage, int32 shots, int32 distWalk)
+    {
+        humanTurn();
+
+        switch (state)
+        {
+            case STATE_STOP:
+            {
+                if (nextState)
+                    return nextState;
+                if (canSee(DIST_SHOT))
+                    return STATE_AIM;
+                if (mood == MOOD_SLEEP)
+                    return STATE_WALK;
+                return STATE_RUN;
+            }
+
+            case STATE_WALK:
+            {
+                if (mood == MOOD_ESCAPE || !tinfo.front)
+                    nextState = STATE_RUN;
+                else if (canSee(DIST_SHOT))
+                    nextState = STATE_AIM;
+                else if (tinfo.dist > distWalk)
+                    nextState = STATE_RUN;
+                else
+                    break;
+                return STATE_STOP;
+            }
+
+            case STATE_RUN:
+            {
+                if (mood == MOOD_ESCAPE || !tinfo.front)
+                    break;
+                if (canSee(DIST_SHOT))
+                    nextState = STATE_AIM;
+                else if (tinfo.dist < distWalk && tinfo.front)
+                    nextState = STATE_WALK;
+                else
+                    break;
+                return STATE_STOP;
+            }
+
+            case STATE_AIM:
+            {
+                if (nextState)
+                    return STATE_STOP;
+                return canSee(DIST_SHOT) ? STATE_WAIT : STATE_STOP;
+            }
+
+            case STATE_WAIT:    // fire
+            {
+                if (!nextState) {
+                    for (int32 i = 0; i < shots; i++)
+                        shoot(damage, DIST_SHOT);
+                    nextState = STATE_STOP;
+                }
+                if (mood == MOOD_ESCAPE)
+                    nextState = STATE_RUN;
+                break;
+            }
+        }
+
+        return goalState;
+    }
+};
