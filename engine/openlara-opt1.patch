diff -ruN a/src/platform/32x/bench.inc b/src/platform/32x/bench.inc
--- a/src/platform/32x/bench.inc	1969-12-31 16:00:00.000000000 -0800
+++ b/src/platform/32x/bench.inc	2026-10-20 18:27:01.831751933 -0700
@@ -0,0 +1,41 @@
+/* ---------------------------------------------------------------------------------------
+ * BENCH-1: a fixed, repeatable workload for measuring engine changes (make CD32X=1 BENCH=1,
+ *   emulator use only - never a release).  The game starts straight in Caves, the game logic
+ *   runs exactly one step per drawn frame (no frame skipping, no waiting for the screen
+ *   refresh), and the pad is scripted: still, turn left, run, turn right.  After BENCH_FRAMES
+ *   frames the last picture stays on screen and COMM12 = 0xBEEF.  Every build draws exactly
+ *   the same frames, so pictures can be compared bit for bit and the SH2 clocks spent in
+ *   the drawing code compared between builds.
+ * --------------------------------------------------------------------------------------- */
+#define BENCH_FRAMES 150
+static int32 gBenchFrame = 0;
+
+static uint16 benchPad()
+{
+    int32 f = gBenchFrame;
+    if (f < 30)  return 0;
+    if (f < 80)  return SEGA_CTRL_LEFT;
+    if (f < 110) return SEGA_CTRL_UP;
+    if (f < 130) return SEGA_CTRL_RIGHT;
+    return 0;
+}
+
+/* BENCH-1: how deep the master's stack goes.  At start the free SDRAM between the end of .bss
+   and the stack pointer is painted; at the end the unpainted part is the deepest use.  The free
+   bytes that were never touched go to COMM8 (shown by ares-headless as the 5th COMM word). */
+extern uint8 _end[];
+#define BENCH_PAINT 0x5AA5C33Cu
+static void benchPaint()
+{
+    uint32 sp;
+    __asm__ volatile ("mov r15,%0" : "=r"(sp));
+    for (uint32* p = (uint32*)(((uint32)_end + 3) & ~3); (uint32)p < sp - 256; p++) *p = BENCH_PAINT;
+}
+
+static void benchStackReport()
+{
+    uint32* p = (uint32*)(((uint32)_end + 3) & ~3);
+    uint32* start = p;
+    while (*p == BENCH_PAINT) p++;
+    MARS_SYS_COMM8 = (uint16)((uint32)(p - start) * 4 > 0xFFFF ? 0xFFFF : (p - start) * 4);
+}
