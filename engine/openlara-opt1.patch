         gSplitVote = 0;
@@ -1851,3 +1854,27 @@
 //    return gBackgroundCopy;
     return NULL;
 }
+
+#ifdef CD32X_LMAP16
+/* OPT-1: gLightmap with every byte doubled into a 16-bit pixel pair, for the textured span
+ * loop (asm/rasterizeFT.i): one 16-bit load gives the two screen pixels a texel covers, where
+ * the 8-bit table needed a load, a zero-extend, a byte swap and an OR.  Same indexing as the
+ * 8-bit table: the asm reads gLightmap_base + (g << 8) + (int8)texel; here
+ * gLightmap16 + 256 + (g << 9) + 2 * (int8)texel.  16 KB of SDRAM (.bss). */
+extern "C" uint16 gLightmap16[256 * 32] __attribute__((aligned(16)));
+uint16 gLightmap16[256 * 32] __attribute__((aligned(16)));
+
+void lightmap16Build()
+{
+    const uint8* base = (const uint8*)gLightmap - 128;     /* = gLightmap_base (crt0.s) */
+    for (int32 g = 0; g < 32; g++)
+    {
+        for (int32 s = -128; s < 128; s++)
+        {
+            int32 ofs = (g << 8) + s;
+            uint32 v = (ofs >= 0) ? base[ofs] : 0;           /* g 0, texel >= 128: below the table */
+            gLightmap16[(g << 8) + 128 + s] = uint16(v | (v << 8));
+        }
+    }
+}
+#endif
