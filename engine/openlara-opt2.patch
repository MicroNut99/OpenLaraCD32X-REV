+/* ---------------------------------------------------------------------------------------
+ * RESUME-1: the level slot (cart 2 MB) keeps its level without power too, so the first level
+ *   after power-on (Current Position, or a level from the passport) is not loaded from the CD
+ *   again when it is already there.  Same rules as Caves:
+ *     0x3F0310  'OLLV', level, file length, checksum, ~checksum   (written after a full load)
+ *   - checked once per power-on (gCartLevel -2): same level, same length as the file on this
+ *     disc, checksum of what is in the cart now matches -> no loading.  Anything else (a
+ *     movie or the cart test's load test used the slot, a half-finished load) -> the CD.
+ *   - A + B + C held: always load from the CD.
+ * --------------------------------------------------------------------------------------- */
+#define CS_SLOT               0x3F0310             /* record: after Caves', before the save */
+#define SLOT_MARK             0x4F4C4C56           /* 'OLLV' */
+
+static uint32 slotSum(int32 len)                   /* checksum of the level slot's contents */
+{
+    const uint32* p = (const uint32*)CD_LEVEL_CART;
+    uint32 s = SLOT_MARK;
+    int32 n = len >> 2;
+    for (int32 i = 0; i < n; i++)
+        s = ((s << 1) | (s >> 31)) + p[i];
+    const uint8* b = (const uint8*)CD_LEVEL_CART + (n << 2);
+    for (int32 i = 0; i < (len & 3); i++)
+        s = ((s << 1) | (s >> 31)) + b[i];
+    return s;
+}
+
+static bool slotInCart(int32 id)                   /* true = level id is complete in the slot */
+{
+    if (cartRead32(CS_SLOT) != SLOT_MARK || (int32)cartRead32(CS_SLOT + 4) != id)
+        return false;
+    MARS_SYS_COMM2 = (uint16)(CD_FILE_LEVEL_BASE + id);
+    cdCmd(CD_CMD_OPEN_FILE);                       /* only looks the file up: its length */
+    if (MARS_SYS_COMM0 != 0)
+        return false;
+    int32 len = (int32)CD_COMM8_32;
+    if (len <= 0 || (int32)cartRead32(CS_SLOT + 8) != len)
+        return false;
+    uint32 sum = cartRead32(CS_SLOT + 12);
+    if (cartRead32(CS_SLOT + 16) != ~sum)
+        return false;
+
+    CacheClear();                                  /* read what is really in the cart */
+    bool ok = (slotSum(len) == sum);
+    CacheClear();
+    return ok;
+}
+
+static void slotRecord(int32 id, int32 len)        /* the slot now holds level id, complete */
+{
+    uint32 sum = slotSum(len);                     /* caches already cleared by the caller */
+    cartWrite32(CS_SLOT, 0);
+    cartWrite32(CS_SLOT + 4, (uint32)id);
+    cartWrite32(CS_SLOT + 8, (uint32)len);
+    cartWrite32(CS_SLOT + 12, sum);
+    cartWrite32(CS_SLOT + 16, ~sum);
+    cartWrite32(CS_SLOT, SLOT_MARK);               /* marker last */
+    csEnd();
+    CacheClear();
+}
+
 static const void* cavesLoad(LevelID id)
 {
     MARS_WAIT();                                   /* slave idle */
@@ -731,6 +792,18 @@
