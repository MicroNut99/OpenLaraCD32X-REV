+extern "C" uint16 gLightmap16[256 * (LMAP16_ROWS + 1)] __attribute__((aligned(512)));
+uint16 gLightmap16[256 * (LMAP16_ROWS + 1)] __attribute__((aligned(512)));
+
+/* OPT-2: the Gouraud loop turns g (gLightmap_base + 8.8 light) into 2 * g + gLightmap16G */
+extern "C" uint32 gLightmap16G;
+uint32 gLightmap16G;
 
 void lightmap16Build()
 {
     const uint8* base = (const uint8*)gLightmap - 128;     /* = gLightmap_base (crt0.s) */
-    for (int32 g = 0; g < 32; g++)
+    gLightmap16G = uint32(intptr_t(gLightmap16) + 512 - 2 * intptr_t(base));
+    for (int32 g = 0; g < LMAP16_ROWS; g++)
     {
         for (int32 s = -128; s < 128; s++)
         {
             int32 ofs = (g << 8) + s;
             uint32 v = (ofs >= 0) ? base[ofs] : 0;           /* g 0, texel >= 128: below the table */
-            gLightmap16[(g << 8) + 128 + s] = uint16(v | (v << 8));
+            gLightmap16[(g << 8) + 256 + s] = uint16(v | (v << 8));
         }
     }
