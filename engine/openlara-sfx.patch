diff -ruN a/src/platform/32x/sfx.inc b/src/platform/32x/sfx.inc
--- a/src/platform/32x/sfx.inc	1969-12-31 16:00:00.000000000 -0800
+++ b/src/platform/32x/sfx.inc	2026-10-21 21:00:17.760507333 -0700
@@ -0,0 +1,326 @@
+/* ---------------------------------------------------------------------------------------
+ * SFX-2: every sound effect of the level through the 32X PWM (included by main.cpp after
+ *   fmv.inc, CD32X build only).
+ *
+ *   The samples: tools/sfx_bank.py appends a bank to each level file (.PKD) and points the
+ *   level header's soundData / soundOffsets at it, so the bank is loaded into the cart with
+ *   the level by the normal level load - no new Sub-CPU command, no change to the boot stack.
+ *     soundData:    'SFXB' u16 rate u16 count, then records: u32 length + signed 8-bit PCM
+ *     soundOffsets: s32[count], each record relative to soundData (-1 = none)
+ *   A level file without a bank (an older disc) keeps the Sega CD PCM packs (SFX-1).
+ *
+ *   The mixer runs on the SLAVE, in the DMA 1 interrupt (sec_dma1_handler, crt0.s level 4):
+ *   DMA 1 feeds the PWM (mono) from one of two blocks, paced by the PWM's requests; when a
+ *   block ends the other one starts and the ended one is mixed again.  The slave now runs
+ *   with interrupt level 3 (was 13), so only the DMA interrupt (priority 4) gets through:
+ *   the slave's 32X interrupts stay off (INTMSK 0) and no other on-chip unit is enabled.
+ *   - Mixing rate = the bank's rate (5000-8000 Hz), each mixed sample written mul times
+ *     so the PWM runs at 20-24 kHz (no audible carrier).  Blocks of up to 316 words: the
+ *     movie player's buffers (gFmvSnd), never used at the same time.
+ *   - Samples are read cache-through from the cart (the slave's cache stays the renderer's).
+ *   - 8 channels.  The engine's modes as on the GBA: UNIQUE = a sample already playing only
+ *     gets the new volume, REPLAY = it restarts, others = a new channel.  A full mixer drops
+ *     the quietest channel for a louder sound.
+ *   - The master never touches the mixer's state: requests go through a ring of 32 words
+ *     (cache-through), read at the start of every block.
+ * --------------------------------------------------------------------------------------- */
+#define MARS_CMD_SFX_START  0x7A5E              /* slave: mix the bank in gSfxData... */
+#define MARS_CMD_SFX_STOP   0x7A5F              /* slave: DMA off, the PWM stays at silence */
+#define SFX_CHANNELS        8
+#define SFX_QUEUE           32
+#define SFX_GAIN            2                   /* SFX-3: volume, x/16 of the mix (2: as tested on the
+                                                   console, 21 Oct 2026); full volume: +-127 of +-478 */
+#define SFX_SHARED(v)       (*(volatile __typeof__(v) *)((uint32)&(v) | 0x20000000))
+#define SFX_THROUGH(p)      ((const uint8*)((uint32)(p) | 0x20000000))
+#define SFX_OP_PLAY         1u
+#define SFX_OP_STOP         2u
+#define SFX_OP_STOPALL      3u
+
+/* shared: written by the master (cache-through), read by the slave (cache-through) */
+static const uint8* gSfxData;                   /* the bank, cache-through address */
+static const uint8* gSfxOffsets;                /* s32[count], cache-through address */
+static int32 gSfxCount;
+static int32 gSfxRate;
+static uint32 gSfxQueue[SFX_QUEUE];
+static int32 gSfxHead;                          /* the master's */
+static int32 gSfxTail;                          /* the slave's */
+static int32 gSfxOn = 0;                        /* master: the mixer runs */
+
+/* ------------------------------------------------------------------------------ the slave */
+struct SfxChan
+{
+    const uint8* p;                             /* the sample, cache-through; NULL = free */
+    uint32 pos;                                 /* 16.16 */
+    uint32 end;                                 /* length << 16 */
+    uint32 inc;
+    int32 vol;                                  /* 0..64 */
+    int32 index;
+};
+static SfxChan gSfxChan[SFX_CHANNELS];
+static int16 gSfxAcc[160];                      /* one block before the PWM conversion */
+static int32 gSfxRun = 0;                       /* slave: DMA running */
+static int32 gSfxPlaying;                       /* the block the DMA plays */
+static int32 gSfxMul, gSfxN, gSfxCenter, gSfxMax;
+static const uint8* gSfxBank;                   /* slave copies of the shared bank */
+static const uint8* gSfxTable;
+static int32 gSfxBankCount;
+
+static inline uint32 sfxRead32(const uint8* p)  /* cache-through, 2-byte aligned */
+{
+    const volatile uint16* w = (const volatile uint16*)p;
+    return ((uint32)w[0] << 16) | w[1];
+}
+
+static void sfxRequest(uint32 r)
+{
+    uint32 op = r >> 30;
+    if (op == SFX_OP_STOPALL)
+    {
+        for (int32 i = 0; i < SFX_CHANNELS; i++)
+            gSfxChan[i].p = NULL;
+        return;
+    }
+    int32 index = int32(r & 0xFF);
+    if (op == SFX_OP_STOP)
+    {
+        for (int32 i = 0; i < SFX_CHANNELS; i++)
+            if (gSfxChan[i].p && gSfxChan[i].index == index)
+                gSfxChan[i].p = NULL;
+        return;
+    }
+    if (index >= gSfxBankCount)
+        return;
+    int32 ofs = int32(sfxRead32(gSfxTable + index * 4));
+    if (ofs < 0)
+        return;
+    const uint8* rec = gSfxBank + ofs;
+    uint32 len = sfxRead32(rec);
+    if (!len)
+        return;
+    int32 vol = int32((r >> 8) & 0x7F);
+    uint32 inc = ((r >> 16) & 0xFF) << 9;       /* pitch 128 = 1.0 */
+    int32 mode = int32((r >> 28) & 3);
+
+    if (mode == UNIQUE || mode == REPLAY)
+    {
+        for (int32 i = 0; i < SFX_CHANNELS; i++)
+        {
+            SfxChan &c = gSfxChan[i];
+            if (c.p && c.index == index)
+            {
+                c.vol = vol;
+                c.inc = inc;
+                if (mode == REPLAY)
+                    c.pos = 0;
+                return;
+            }
+        }
+    }
+
+    SfxChan* best = NULL;                       /* a free channel, or the quietest */
+    for (int32 i = 0; i < SFX_CHANNELS; i++)
+    {
+        SfxChan* c = gSfxChan + i;
+        if (!c->p) { best = c; break; }
+        if (!best || c->vol < best->vol)
+            best = c;
+    }
+    if (best->p && best->vol > vol)
+        return;
+    best->p = rec + 4;
+    best->pos = 0;
+    best->end = len << 16;
+    best->inc = inc;
+    best->vol = vol;
+    best->index = index;
+}
+
+static void sfxFill(int32 b)                    /* mix block b */
+{
+    int32 tail = gSfxTail;
+    int32 head = SFX_SHARED(gSfxHead);
+    while (tail != head)
+    {
+        sfxRequest(SFX_SHARED(gSfxQueue[tail]));
+        tail = (tail + 1) & (SFX_QUEUE - 1);
+    }
+    gSfxTail = tail;
+    SFX_SHARED(gSfxTail) = tail;
+
+    const int32 n = gSfxN;
+    int16* acc = gSfxAcc;
+    for (int32 i = 0; i < n; i++)
+        acc[i] = 0;
+
+    for (int32 k = 0; k < SFX_CHANNELS; k++)
+    {
+        SfxChan &c = gSfxChan[k];
+        if (!c.p)
+            continue;
+        const int8* p = (const int8*)c.p;
+        uint32 pos = c.pos, inc = c.inc, end = c.end;
+        int32 vol = c.vol;
+        int32 i = 0;
+        for (; i < n && pos < end; i++)
+        {
+            acc[i] += int16((p[pos >> 16] * vol) >> 3);
+            pos += inc;
+        }
+        c.pos = pos;
+        if (pos >= end)
+            c.p = NULL;
+    }
+
+    uint16* out = (uint16*)((uint32)gFmvSnd[b] | 0x20000000);
+    const int32 mul = gSfxMul, center = gSfxCenter, max = gSfxMax;
+    for (int32 i = 0; i < n; i++)
+    {
+        int32 v = (acc[i] * SFX_GAIN) >> 4;     /* louder sounds together: clipped below */
+        if (v > max) v = max; else if (v < -max) v = -max;
+        uint16 w = uint16(center + v);
+        for (int32 j = 0; j < mul; j++)
+            *out++ = w;
+    }
+}
+
+static void sfxDma(int32 b)                     /* DMA 1 -> PWM mono, interrupt at the end */
+{
+    SH2_DMA_CHCR1 = 0;
+    SH2_DMA_SAR1 = (uint32)gFmvSnd[b] | 0x20000000;
+    SH2_DMA_DAR1 = (uint32)&MARS_PWM_MONO;
+    SH2_DMA_TCR1 = gSfxN * gSfxMul;
+    SH2_DMA_CHCR1 = 0x14e5;                     /* as the movies' (fmvAudioStart) + IE */
+}
+
+static void sfxIrq()                            /* slave, DMA 1 end */
+{
+    if (!gSfxRun)
+        return;
+    int32 ended = gSfxPlaying;
+    gSfxPlaying ^= 1;
+    sfxDma(gSfxPlaying);
+    sfxFill(ended);
+}
+
+static void sfxStart()                          /* slave: MARS_CMD_SFX_START */
+{
+    gSfxRun = 0;
+    SH2_DMA_CHCR1 = 0;
+    gSfxBank = SFX_SHARED(gSfxData);
+    gSfxTable = SFX_SHARED(gSfxOffsets);
+    gSfxBankCount = SFX_SHARED(gSfxCount);
+    int32 rate = SFX_SHARED(gSfxRate);
+    gSfxMul = (20000 + rate - 1) / rate;        /* PWM at 20-24 kHz */
+    gSfxN = 316 / gSfxMul;
+    if (gSfxN > 160) gSfxN = 160;
+    int32 clock = (MARS_VDP_DISPMODE & MARS_NTSC_FORMAT) ? 23011361 : 22801467;
+    int32 cycle = (((clock << 1) / (rate * gSfxMul) + 1) >> 1) + 1;
+    gSfxCenter = cycle >> 1;
+    gSfxMax = gSfxCenter - 2;
+
+    for (int32 i = 0; i < SFX_CHANNELS; i++)
+        gSfxChan[i].p = NULL;
+    gSfxTail = SFX_SHARED(gSfxTail);
+
+    MARS_PWM_CYCLE = cycle;
+    if (gSfxPwmLast <= 1)                       /* PWM off (start, or after a movie) */
+    {
+        MARS_PWM_CTRL = 0x0185;
+        fmvPwmRamp(1, gSfxCenter, 16);          /* slowly to silence: no click */
+    }
+    else
+    {
+        while (MARS_PWM_MONO & 0x8000) {}       /* the same duty (half) at the new cycle */
+        MARS_PWM_MONO = (uint16)gSfxCenter;
+    }
+    gSfxPwmLast = gSfxCenter;
+
+    sfxFill(0);
+    sfxFill(1);
+    gSfxPlaying = 0;
+    gSfxRun = 1;
+    sfxDma(0);
+}
+
+static void sfxStop()                           /* slave: MARS_CMD_SFX_STOP */
+{
+    gSfxRun = 0;
+    SH2_DMA_CHCR1 = 0;                          /* the PWM keeps its last value: silence */
+}
+
+/* ----------------------------------------------------------------------------- the master */
+void sfxBankStop()                              /* before a level load or a movie */
+{
+    if (!gSfxOn)
+        return;
+    MARS_WAIT();
+    MARS_SYS_COMM4 = MARS_CMD_SFX_STOP;
+    MARS_WAIT();
+    gSfxOn = 0;
+}
+
+void sfxBankStart()                             /* after a level load: its bank, if it has one */
+{
+    sfxBankStop();
+    uint32 d = (uint32)level.soundData;
+    uint32 o = (uint32)level.soundOffsets;
+    int32 n = level.soundOffsetsCount;
+    if (n <= 0 || n > 255 || (d & 3) || (o & 3) ||
+        d < 0x02000000 || d >= 0x02400000 || o < 0x02000000 || o >= 0x02400000)
+        return;                                 /* no bank: the Sega CD PCM packs play */
+    const uint8* bank = SFX_THROUGH(d);
+    if (sfxRead32(bank) != 0x53465842)          /* 'SFXB' */
+        return;
+    uint32 rn = sfxRead32(bank + 4);
+    int32 rate = int32(rn >> 16);
+    if (rate < 4000 || rate > 11025 || int32(rn & 0xFFFF) != n)
+        return;
+
+    SFX_SHARED(gSfxData) = bank;
+    SFX_SHARED(gSfxOffsets) = SFX_THROUGH(o);
+    SFX_SHARED(gSfxCount) = n;
+    SFX_SHARED(gSfxRate) = rate;
+    SFX_SHARED(gSfxHead) = 0;
+    SFX_SHARED(gSfxTail) = 0;
+    gSfxHead = 0;
+    MARS_WAIT();
+    MARS_SYS_COMM4 = MARS_CMD_SFX_START;
+    MARS_WAIT();
+    gSfxOn = 1;
+}
+
+static void sfxPush(uint32 r)
+{
+    int32 head = gSfxHead;
+    int32 next = (head + 1) & (SFX_QUEUE - 1);
+    if (next == SFX_SHARED(gSfxTail))
+        return;                                 /* full: dropped */
+    SFX_SHARED(gSfxQueue[head]) = r;
+    SFX_SHARED(gSfxHead) = next;
+    gSfxHead = next;
+}
+
+bool sfxPlay(int32 index, int32 volume, int32 pitch, int32 mode)   /* false = no bank */
+{
+    if (!gSfxOn)
+        return false;
+    if (index < 0 || index > 255 || volume <= 0)
+        return true;
+    if (volume > 64) volume = 64;
+    if (pitch < 1) pitch = 1; else if (pitch > 255) pitch = 255;
+    sfxPush((SFX_OP_PLAY << 30) | (uint32(mode & 3) << 28) | (uint32(pitch) << 16) |
+            (uint32(volume) << 8) | uint32(index));
+    return true;
+}
+
+void sfxStopSample(int32 index)
+{
+    if (gSfxOn && index >= 0 && index <= 255)
+        sfxPush((SFX_OP_STOP << 30) | uint32(index));
+}
+
+void sfxStopAll()
+{
+    if (gSfxOn)
+        sfxPush(SFX_OP_STOPALL << 30);
+}
